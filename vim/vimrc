    " Automatic session for tmux-resurrect (g:vimrc_features.auto_session)
    " -- tmux-resurrect restores vim with 'vim -S' only when the pane's
    "    directory has a Session.vim, so keep one up to date with :Obsess
    "    (vim-obsession) when vim starts inside tmux in a git root
    " -- Skipped for: diff mode (mergetool/difftool), files outside the
    "    directory or inside .git (commit messages, agent editor temp files),
    "    stdin/-q/-t/-c/+cmd starts (pipes, quickfix, man pages), and vim
    "    started with --cmd 'let g:vimrc_no_session = 1' (tmux popups)
    " -- Not restored when its files are open in another vim (swap files)
    " -- A restored session ('vim -S') resumes tracking by itself
    " -- An existing Session.vim is never overwritten: plain 'vim' (no file
    "    arguments) restores it; 'vim file' leaves it alone (:Obsess to
    "    replace it with this vim's layout)
    " -- Session.vim is added to the repo's .git/info/exclude (local, never
    "    committed) unless git already ignores it
    " -- Stop tracking in this vim: :Obsess! (also deletes Session.vim)
    function! s:SessionExclude(dir) abort
        let l:git = 'git -C ' . shellescape(a:dir) . ' '
        call system(l:git . 'check-ignore -q Session.vim')
        if !v:shell_error
            return
        endif
        let l:exclude = trim(system(l:git
                    \ . 'rev-parse --path-format=absolute --git-path info/exclude'))
        if v:shell_error || empty(l:exclude)
            return
        endif
        call mkdir(fnamemodify(l:exclude, ':h'), 'p')
        " Start on a new line when the file does not end with a newline
        let l:old = filereadable(l:exclude) ? readfile(l:exclude, 'b') : []
        call writefile((!empty(l:old) && l:old[-1] !=# '' ? [''] : [])
                    \ + ['Session.vim'], l:exclude, 'a')
    endfunction
    " Files of a Session.vim that another running vim has open (it has a
    " swap file for them), e.g. a second vim started in the same repo
    " -- Swap files are found by name: 'directory' ends in // (full path with
    "    % for /), see the backup/swap settings
    function! s:SessionFilesInUse(session) abort
        let l:dirs = filter(map(split(&directory, ','), 'expand(v:val)'),
                    \ 'v:val =~# "//$"')
        let l:in_use = []
        for l:line in readfile(a:session)
            let l:m = matchlist(l:line, '\v^%(badd \+\d+|edit|balt) (.+)$')
            if empty(l:m)
                continue
            endif
            " Session files escape spaces etc. with a backslash
            let l:file = fnamemodify(substitute(l:m[1], '\\\(.\)', '\1', 'g'), ':p')
            for l:dir in l:dirs
                for l:ext in ['.swp', '.swo', '.swn']
                    let l:swap = l:dir . substitute(l:file, '/', '%', 'g') . l:ext
                    if !filereadable(l:swap)
                        continue
                    endif
                    let l:pid = get(swapinfo(l:swap), 'pid', 0)
                    if l:pid > 0 && l:pid != getpid()
                                \ && (!isdirectory('/proc') || isdirectory('/proc/' . l:pid))
                                \ && index(l:in_use, l:file) < 0
                        call add(l:in_use, l:file)
                    endif
                endfor
            endfor
        endfor
        return l:in_use
    endfunction
    " Vim started without a file, stdin, quickfix file, tag or command, so
    " restoring/recording a session cannot replace what was asked for
    " (cmd | vim -, vim -q, vim -t, vim -c / +cmd, MANPAGER='nvim +Man!')
    " -- With file arguments only the start options count (vim +42 file.py
    "    is not a plain start either)
    function! s:CleanStart() abort
        for l:arg in get(v:, 'argv', [])[1:]
            if l:arg ==# '--'
                break
            endif
            " -q/-t/-c with or without a joined value (-qerrors.err, -tTag)
            if l:arg ==# '-' || l:arg =~# '^-[qtc]' || l:arg =~# '^+'
                return 0
            endif
        endfor
        return argc() > 0 || (bufname('') ==# '' && line('$') == 1
                    \ && getline(1) ==# '' && !&modified && empty(getqflist()))
    endfunction
    function! s:AutoSession() abort
        if !s:on('auto_session') || empty($TMUX) || &diff
                    \ || exists('g:this_obsession') || exists('g:vimrc_no_session')
                    \ || !exists(':Obsess')
            return
        endif
        let l:cwd = getcwd()
        if !isdirectory(l:cwd . '/.git') && !filereadable(l:cwd . '/.git')
            return
        endif
        for l:arg in argv()
            let l:path = fnamemodify(l:arg, ':p')
            if stridx(l:path, l:cwd . '/') != 0 || l:path =~# '/\.git/'
                return
            endif
        endfor
        if !s:CleanStart()
            return
        endif
        let l:session = l:cwd . '/Session.vim'
        if filereadable(l:session)
            if argc() > 0
                echomsg 'Session.vim exists here: not tracking this vim'
                            \ . ' (:source Session.vim restores it, :Obsess replaces it)'
                return
            endif
            let l:in_use = s:SessionFilesInUse(l:session)
            if !empty(l:in_use)
                echomsg 'Session.vim not restored: ' . len(l:in_use)
                            \ . ' of its files are open in another vim (e.g. '
                            \ . fnamemodify(l:in_use[0], ':~:.') . ')'
                return
            endif
            " Restores the layout; the file resumes tracking (Obsession)
            execute 'silent! source' fnameescape(l:session)
            call s:SessionExclude(l:cwd)
            echomsg 'Restored Session.vim (:Obsess! stops tracking and deletes it)'
            return
        endif
        call s:SessionExclude(l:cwd)
        silent! Obsess
    endfunction
    " nested: buffers restored from Session.vim get their filetype autocmds
    autocmd vimrc VimEnter * nested call s:AutoSession()

