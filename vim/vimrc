        " Fold according to header (computed on first use, kept as manual folds)
        " NOTE:
        " -- With 'expr', vimwiki recomputes VimwikiFoldLevel() for every line
        "    on each keystroke (Vim) and every time a note enters a window:
        "    ~100 ms per switch into a 1200-line note, 6x slower typing.
        " -- 'custom' stops vimwiki from (re)setting folds. Notes open with
        "    manual folding and no folds (folding is off anyway: nofoldenable),
        "    so opening, switching and typing cost nothing.
        " -- The first fold key in a note (zc zo za zM zR zi zj zk zx ...)
        "    computes the same header folds with VimwikiFoldLevel() (about
        "    0.5 s for a 1200-line note, once per window), then runs as usual.
        "    zx / zX recompute the folds (e.g. after editing headers).
        " -- Once computed, folds are refreshed on save (:w), on reload (e.g.
        "    agent edit) and when the changed note is shown again. Closed folds
        "    stay closed across refreshes. Between saves they may be stale.
        let g:vimwiki_folding = 'custom'
        function! VimwikiFoldsUpdate(force) abort
            if &filetype !=# 'vimwiki' || &diff
                return
            endif
            if !a:force && get(w:, 'vw_fold_buf', -1) == bufnr('')
                        \ && get(w:, 'vw_fold_tick', -1) == b:changedtick
                return
            endif
            let l:view = winsaveview()
            let l:fen = &l:foldenable
            " Remember closed folds (start lines) to restore after refresh
            let l:closed = []
            if get(w:, 'vw_fold_buf', -1) == bufnr('')
                let l:lnum = 1
                while l:lnum <= line('$')
                    let l:start = foldclosed(l:lnum)
                    if l:start != -1
                        call add(l:closed, l:start)
                        let l:lnum = foldclosedend(l:lnum) + 1
                    else
                        let l:lnum += 1
                    endif
                endwhile
            endif
            setlocal foldtext=VimwikiFoldText()
            setlocal foldexpr=VimwikiFoldLevel(v:lnum)
            setlocal foldmethod=expr
            " zx computes the folds now (and applies 'foldlevel')
            silent! normal! zx
            setlocal foldmethod=manual
            if get(w:, 'vw_fold_buf', -1) == bufnr('')
                silent! normal! zR
                for l:start in l:closed
                    silent! execute l:start . 'foldclose'
                endfor
            endif
            let &l:foldenable = l:fen
            let w:vw_fold_buf = bufnr('')
            let w:vw_fold_tick = b:changedtick
            call winrestview(l:view)
        endfunction
        " Folds already computed in this window for this buffer?
        function! s:VimwikiFoldsComputed() abort
            return get(w:, 'vw_fold_buf', -1) == bufnr('')
        endfunction
        " Fold key wrapper: compute folds first (zx/zX: always), then run key
        function! s:VimwikiFoldKey(key, count) abort
            call VimwikiFoldsUpdate(a:key =~# '^z[xX]$')
            execute 'normal! ' . (a:count ? a:count : '') . a:key
        endfunction
        " Buffer-local wrappers for the fold keys in notes (same behaviour)
        function! s:VimwikiFoldKeys() abort
            setlocal foldmethod=manual foldtext=VimwikiFoldText()
            for l:key in ['za', 'zA', 'zc', 'zC', 'zo', 'zO', 'zv', 'zx', 'zX',
                        \ 'zm', 'zM', 'zr', 'zR', 'zn', 'zN', 'zi', 'zj', 'zk',
                        \ '[z', ']z']
                execute printf('nnoremap <buffer><silent> %s '
                            \ . ':<C-u>call <SID>VimwikiFoldKey(%s, v:count)<CR>',
                            \ l:key, string(l:key))
            endfor
        endfunction
        " On reload (FileType again) the window is not ready yet: refresh
        " right after the current command, only where folds are in use
        function! s:VimwikiFoldsLater() abort
            let l:win = win_getid()
            call timer_start(0, {-> win_execute(l:win,
                        \ 'if get(w:, "vw_fold_buf", -1) == bufnr("")'
                        \ . ' | call VimwikiFoldsUpdate(0) | endif', 'silent!')})
        endfunction
        autocmd vimrc FileType vimwiki call s:VimwikiFoldKeys()
                    \ | call s:VimwikiFoldsLater()
        autocmd vimrc BufWinEnter *
                    \ if s:VimwikiFoldsComputed() | call VimwikiFoldsUpdate(0) | endif
        autocmd vimrc BufWritePost *
                    \ if s:VimwikiFoldsComputed() | call VimwikiFoldsUpdate(1) | endif
