            nnoremap <leader>tr :split<CR>:terminal ranger<CR>
            nnoremap <leader>tt :split<CR>:terminal env -u TMUX tmux new-session -A -s scratch<CR>
        else
            nnoremap <F12> :terminal<CR>
            nnoremap <leader>tm :terminal<CR>
            nnoremap <leader>tr :terminal ranger<CR>
            nnoremap <leader>tt :terminal env -u TMUX tmux new-session -A -s scratch<CR>
        endif
        " Map key to go back from terminal mode to normal mode
        " Do not use Esc (which conflicts with fzf window) but <C-\><C-n>
        tnoremap <leader><F12> <C-\><C-n>:echo 'Back to Normal Mode'<CR>
        tnoremap <F12> <C-\><C-n>:echo 'Back to Normal Mode'<CR>
        "tnoremap kj <C-\><C-n>:echo 'Back to Normal Mode'<CR>
        tnoremap <C-h> <C-\><C-n><C-w>h
        tnoremap <C-j> <C-\><C-n><C-w>j
        tnoremap <C-k> <C-\><C-n><C-w>k
        tnoremap <C-l> <C-\><C-n><C-w>l
