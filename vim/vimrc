" Part 9 - Language Server Protocol (LSP)
" ============================================================================

" Vim-LSP --------------------------------------------------------------------
    " NOTE:
    " -- LSP is DISABLED at startup: no language server starts until you ask
    "    with <leader>Le (enable in all buffers), <leader>Ld disables again
    " -- Server management keys (<leader>L[M/I/S/R/s]) work in every buffer
    if s:on('lsp') && g:vimrc_is_vim8
        " Disable LSP at startup
        let g:lsp_auto_enable = 0
        " Python servers installed/used by vim-lsp-settings
        let g:lsp_settings_filetype_python = g:vimrc_tools.python_lsp_servers
        let g:lsp_preview_float = 1
        let g:lsp_preview_keep_focus = 1
        " Hover (K) as a floating popup at the cursor (was a preview split)
        let g:lsp_hover_ui = 'float'
        " Alt keys used to scroll LSP floats (<M-e/y/g/G>, see below):
        " terminal vim (not neovim) receives Alt+key as Esc + key, so teach it
        " these key codes. With ttimeoutlen=10 only a real Alt press (both
        " bytes at once) matches; Esc then e typed by hand stays two keys.
        if !g:vimrc_is_nvim && !has('gui_running')
            for s:key in ['e', 'y', 'g', 'G']
                execute 'set <M-' . s:key . ">=\<Esc>" . s:key
            endfor
        endif
        " Neovim: show LSP floats (hover, signature) from their first line.
        " vim-lsp leaves the float's cursor on its last line and the float
        " inherits 'scrolloff' (10), so long docs opened scrolled to the end.
        if g:vimrc_is_nvim
            " Hover float (g:lsp_hover_ui = 'float') and preview float
            " (signature help) are tracked separately by vim-lsp
            function! s:LspFloatTop(...) abort
                for l:winid in [
                            \ lsp#internal#document_hover#under_cursor#getpreviewwinid(),
                            \ lsp#ui#vim#output#getpreviewwinid()]
                    if l:winid > 0 && nvim_win_is_valid(l:winid)
                        call setwinvar(l:winid, '&scrolloff', 0)
                        call win_execute(l:winid, 'normal! gg')
                    endif
                endfor
            endfunction
            " Now, and once more right after the float is filled
            autocmd vimrc User lsp_float_opened call s:LspFloatTop()
                        \ | call timer_start(0, function('s:LspFloatTop'))
        endif
        " Print out log from vim-lsp-settings plugin
        "let g:lsp_log_verbose = 1
        "let g:lsp_log_file = expand('~/vim-lsp.log')

" Completion while LSP is on (asyncomplete) ----------------------------------
        " NOTE:
        " -- asyncomplete runs only in LSP buffers (other buffers keep
        "    AutoComplPop), with three sources: LSP, words from all open
        "    buffers, and file paths (e.g. ./src/<...>)
        " -- deoplete-like menu: the first item is pre-selected (not inserted),
        "    so its signature/docs float shows at once; <CR> accepts it,
        "    <Tab>/<S-Tab>/<C-j>/<C-k> move, <C-e> closes the menu
        " -- Function argument hint (signature help) appears ~0.2 s after ( or ,
        let g:asyncomplete_enable_for_all = 0
        let g:asyncomplete_auto_completeopt = 0
        " 'completeopt' for the pre-selected menu, only while inserting in an
        " LSP buffer (restored on leaving insert mode, so <C-n> elsewhere is
        " unchanged)
        let s:lsp_completeopt = 'menuone,noinsert'
        autocmd vimrc InsertEnter *
                    \ if get(b:, 'asyncomplete_enable', 0)
                    \ | let s:saved_completeopt = &completeopt
                    \ | let &completeopt = s:lsp_completeopt | endif
        autocmd vimrc InsertLeave *
                    \ if exists('s:saved_completeopt')
                    \ | let &completeopt = s:saved_completeopt
                    \ | unlet s:saved_completeopt | endif
        " Words from all open buffers (like deoplete's buffer source)
        " -- Cached per buffer, refreshed on enter, insert leave and write,
        "    only when the buffer changed; the word being typed is excluded
        let s:buffer_words = {}
        function! s:BufferWordsRefresh(bufnr) abort
            if getbufvar(a:bufnr, '&buftype') !=# ''
                        \ || !getbufvar(a:bufnr, '&buflisted')
                return
            endif
            let l:tick = getbufvar(a:bufnr, 'changedtick')
            let l:cache = get(s:buffer_words, a:bufnr, {})
            if get(l:cache, 'tick', -1) == l:tick
                return
            endif
            let l:lines = getbufline(a:bufnr, 1, '$')
            let l:words = {}
            if len(l:lines) <= 20000
                for l:word in split(join(l:lines, "\n"), '\W\+')
                    if len(l:word) > 2
                        let l:words[l:word] = 1
                    endif
                endfor
            endif
            let s:buffer_words[a:bufnr] = {'tick': l:tick, 'words': l:words}
        endfunction
        function! s:BufferWordsCompletor(opt, ctx) abort
            let l:kw = matchstr(a:ctx['typed'], '\w\+$')
            if len(l:kw) < 2
                return
            endif
            call s:BufferWordsRefresh(bufnr(''))
            let l:seen = {l:kw : 1}
            let l:items = []
            for l:bufnr in [bufnr('')] + filter(keys(s:buffer_words),
                        \ 'v:val != bufnr("") && bufexists(str2nr(v:val))')
                for l:word in keys(get(get(s:buffer_words, l:bufnr, {}),
                            \ 'words', {}))
                    if !has_key(l:seen, l:word)
                        let l:seen[l:word] = 1
                        call add(l:items, {'word': l:word, 'menu': '[buffer]'})
                    endif
                endfor
            endfor
            call asyncomplete#complete(a:opt['name'], a:ctx,
                        \ a:ctx['col'] - len(l:kw), l:items)
        endfunction
        " -- Only while LSP is on (g:lsp_user_enabled, set by EnableLSP())
        autocmd vimrc BufEnter,InsertLeave,BufWritePost *
                    \ if get(g:, 'lsp_user_enabled', 0)
                    \ | call s:BufferWordsRefresh(bufnr('')) | endif
        autocmd vimrc BufWipeout *
                    \ if has_key(s:buffer_words, expand('<abuf>'))
                    \ | call remove(s:buffer_words, expand('<abuf>')) | endif
        " Register the buffer-word and file-path sources (LSP source comes
        " from asyncomplete-lsp; lower priority = listed after LSP items,
        " and a word already offered by LSP is not repeated)
        function! s:RegisterCompletionSources() abort
            call asyncomplete#register_source({
                        \ 'name': 'buffer', 'allowlist': ['*'], 'priority': -1,
                        \ 'completor': function('s:BufferWordsCompletor') })
            call asyncomplete#register_source(
                        \ asyncomplete#sources#file#get_source_options({
                        \ 'name': 'file', 'allowlist': ['*'], 'priority': 10,
                        \ 'completor': function('asyncomplete#sources#file#completor') }))
        endfunction
        autocmd vimrc User asyncomplete_setup call s:RegisterCompletionSources()
        " Toggle the automatic pop-up (all LSP buffers); while off, complete
        " on demand with <C-x><C-o>. Key: <leader>` in an LSP buffer (the
        " same key toggles autocomplpop in other buffers)
        function! LspCompletionPopupToggle() abort
            let g:asyncomplete_auto_popup = !get(g:, 'asyncomplete_auto_popup', 1)
            echo 'LSP completion pop-up ' . (g:asyncomplete_auto_popup
                        \ ? 'Enabled' : 'Disabled (<C-x><C-o> on demand)')
        endfunction
        if !s:on('extra')
            nnoremap <leader>` :call LspCompletionPopupToggle()<CR>
        endif

" LSP features: switch each on/off while LSP runs ----------------------------
        " NOTE:
        " -- Start state: g:vimrc_lsp (all on); the current state is kept in
        "    g:vimrc_lsp, so it also applies after <leader>Ld / <leader>Le
        " -- :LspFeature                     show the state of every feature
        "    :LspFeature {name} [on|off]     toggle (or set) one feature
        "    :LspFeature all {on|off}        everything at once
        "    :LspFeature all                 all off, or back to how they were
        " -- Keys <leader>Lt + d diagnostics, v virtual text, c completion,
        "    s signature, r references, a code action, i inlay hints,
        "    p completion doc preview,
        "    t show state, o all on
        " -- <leader>LT: quick switch for all features. If any is on, all go
        "    off (servers and LSP keys stay); pressed again, each feature
        "    returns to its state before (e.g. diagnostics off, rest on)
        " -- Three levels of "off", lightest first:
        "    <leader>LT  features off, servers and LSP keys (gd, K, ...) stay
        "    <leader>Lp  pause: Vim's own keys back, servers keep running,
        "                so <leader>Le is instant
        "    <leader>Ld  stop: Vim's own keys back and servers shut down
        " -- No server restart: diagnostics are hidden per buffer (kept, so
        "    they come back at once), completion hands the buffer back to
        "    AutoComplPop, the others are vim-lsp switches read on each event
        let s:lsp_feature_names = ['diagnostics', 'virtual_text', 'completion',
                    \ 'signature', 'references', 'code_action', 'inlay_hints',
                    \ 'doc_preview']
        " vim-lsp switch behind each feature (diagnostics/completion: per buffer)
        let s:lsp_feature_flag = {
                    \ 'virtual_text': 'lsp_diagnostics_virtual_text_enabled',
                    \ 'signature': 'lsp_signature_help_enabled',
                    \ 'references': 'lsp_document_highlight_enabled',
                    \ 'code_action': 'lsp_document_code_action_signs_enabled',
                    \ 'inlay_hints': 'lsp_inlay_hints_enabled',
                    \ 'doc_preview': 'lsp_completion_documentation_enabled' }
        function! s:LspFeatureSupported(name) abort
            if a:name ==# 'virtual_text'
                return lsp#utils#_has_nvim_virtual_text()
                            \ || lsp#utils#_has_vim_virtual_text()
            elseif a:name ==# 'inlay_hints'
                return !has('nvim') && lsp#utils#_has_vim_virtual_text()
            elseif a:name ==# 'doc_preview'
                return has('nvim') || exists('*popup_create')
            elseif a:name ==# 'code_action'
                return lsp#utils#_has_signs()
            endif
            return 1
        endfunction
        function! s:LspFeatureOn(name) abort
            return get(g:vimrc_lsp, a:name, 1) && s:LspFeatureSupported(a:name)
        endfunction
        " Features switched off (for the statusline), e.g. ['lint', 'cmp'],
        " or ['all'] after <leader>LT
        function! LspFeaturesOff() abort
            if empty(filter(copy(s:lsp_feature_names),
                        \ 'get(g:vimrc_lsp, v:val, 1)'))
                return ['all']
            endif
            let l:short = {'diagnostics': 'lint', 'completion': 'cmp'}
            return map(filter(['diagnostics', 'completion'],
                        \ '!get(g:vimrc_lsp, v:val, 1)'), 'l:short[v:val]')
        endfunction
        " Before lsp#enable(): turn every supported switch on, so vim-lsp
        " registers all features once; they are then filtered by the switch
        function! s:LspFeaturesRegister() abort
            for [l:name, l:flag] in items(s:lsp_feature_flag)
                let g:{l:flag} = s:LspFeatureSupported(l:name)
            endfor
        endfunction
        " Diagnostics and completion for one LSP buffer
        function! s:LspFeatureApplyBuffer(bufnr) abort
            if get(g:vimrc_lsp, 'diagnostics', 1)
                call lsp#enable_diagnostics_for_buffer(a:bufnr)
            else
                call lsp#disable_diagnostics_for_buffer(a:bufnr)
            endif
            if !getbufvar(a:bufnr, 'vimrc_lsp_buffer', 0)
                return
            endif
            " asyncomplete pops up here (LSP + buffer words + file paths), so
            " autocomplpop pauses; with completion off it is the other way
            let l:on = get(g:vimrc_lsp, 'completion', 1)
            if a:bufnr == bufnr('')
                execute 'call asyncomplete#' . (l:on ? 'enable' : 'disable')
                            \ . '_for_buffer()'
            else
                call setbufvar(a:bufnr, 'asyncomplete_enable', l:on)
            endif
            call setbufvar(a:bufnr, 'acp_off', l:on)
            call setbufvar(a:bufnr, 'lsp_acp_off', l:on)
        endfunction
        " Redraw diagnostics (signs, virtual text) of all buffers
        function! s:LspDiagnosticsRedraw() abort
            for l:buf in getbufinfo({'bufloaded': 1})
                if lsp#internal#diagnostics#state#_is_enabled_for_buffer(l:buf.bufnr)
                    call lsp#disable_diagnostics_for_buffer(l:buf.bufnr)
                    call lsp#enable_diagnostics_for_buffer(l:buf.bufnr)
                endif
            endfor
        endfunction
        " Remove reference highlights in the current window/buffer
        function! s:LspReferencesClear() abort
            if exists('w:lsp_reference_matches')
                for l:id in w:lsp_reference_matches
                    silent! call matchdelete(l:id)
                endfor
                unlet w:lsp_reference_matches
                unlet! w:lsp_reference_positions
            endif
            if exists('b:lsp_reference_matches')
                unlet b:lsp_reference_matches
                unlet! b:lsp_reference_positions
            endif
        endfunction
        " Apply one feature's state everywhere (LSP must be on)
        function! s:LspFeatureApply(name) abort
            let l:on = s:LspFeatureOn(a:name)
            if a:name ==# 'diagnostics' || a:name ==# 'completion'
                for l:buf in getbufinfo({'bufloaded': 1})
                    call s:LspFeatureApplyBuffer(l:buf.bufnr)
                endfor
                if exists('*s:AcpBufferSync')
                    call s:AcpBufferSync()
                endif
            elseif a:name ==# 'virtual_text'
                let g:lsp_diagnostics_virtual_text_enabled = l:on
                if l:on
                    " vim-lsp redraws (debounced) on a diagnostics update
                    call s:LspDiagnosticsRedraw()
                elseif s:LspFeatureSupported(a:name)
                    " Clear what is shown now; later updates are filtered out
                    for l:buf in getbufinfo({'bufloaded': 1})
                        if has('nvim')
                            call nvim_buf_clear_namespace(l:buf.bufnr,
                                        \ nvim_create_namespace('vim_lsp_diagnostic_virtual_text'),
                                        \ 0, -1)
                        else
                            for l:type in ['Error', 'Warning', 'Information', 'Hint']
                                silent! call prop_remove({'all': v:true,
                                            \ 'type': 'vim_lsp_Lsp' . l:type . '_virtual_text',
                                            \ 'bufnr': l:buf.bufnr})
                            endfor
                        endif
                    endfor
                endif
            else
                let g:{s:lsp_feature_flag[a:name]} = l:on
                if l:on || !s:LspFeatureSupported(a:name) | return | endif
                " Clear what is shown now (vim-lsp would only clear it on the
                " next InsertEnter/BufLeave)
                if a:name ==# 'references'
                    " Same as vim-lsp's own clearing: matches/positions
                    " variables are removed together (vim-lsp unlets both
                    " on BufLeave, E108 if only one exists)
                    for l:win in getwininfo()
                        call win_execute(l:win.winid,
                                    \ 'call s:LspReferencesClear()')
                    endfor
                    if exists('*prop_remove')
                        for l:buf in getbufinfo({'bufloaded': 1})
                            silent! call prop_remove({'type': 'vim-lsp-reference-highlight',
                                        \ 'bufnr': l:buf.bufnr, 'all': v:true})
                        endfor
                    endif
                elseif a:name ==# 'code_action'
                    call sign_unplace('vim_lsp_document_code_action_signs')
                elseif a:name ==# 'inlay_hints'
                    for l:buf in getbufinfo({'bufloaded': 1})
                        for l:type in ['vim_lsp_inlay_hint_type',
                                    \ 'vim_lsp_inlay_hint_parameter']
                            silent! call prop_remove({'type': l:type,
                                        \ 'bufnr': l:buf.bufnr, 'all': v:true})
                        endfor
                    endfor
                endif
            endif
        endfunction
        function! s:LspFeatureStatus() abort
            let l:items = []
            for l:name in s:lsp_feature_names
                let l:state = get(g:vimrc_lsp, l:name, 1) ? 'on' : 'off'
                if get(g:, 'lsp_user_enabled', 0) && !s:LspFeatureSupported(l:name)
                    let l:state = 'n/a'
                endif
                call add(l:items, l:name . '=' . l:state)
            endfor
            return 'LSP ' . (get(g:, 'lsp_user_enabled', 0) ? 'on' : 'off')
                        \ . ': ' . join(l:items, '  ')
        endfunction
        function! s:LspFeatureCmd(...) abort
            if a:0 == 0
                echo s:LspFeatureStatus()
                return
            endif
            let l:names = a:1 ==# 'all' ? s:lsp_feature_names : [a:1]
            if index(s:lsp_feature_names, a:1) < 0 && a:1 !=# 'all'
                echohl WarningMsg | echo 'Unknown LSP feature: ' . a:1
                            \ . ' (' . join(s:lsp_feature_names, ', ') . ', all)'
                echohl None
                return
            endif
            let l:arg = a:0 > 1 ? a:2 : 'toggle'
            if index(['on', 'off', 'toggle'], l:arg) < 0
                echohl WarningMsg | echo 'Use on, off or toggle' | echohl None
                return
            endif
            if a:1 ==# 'all' && l:arg ==# 'toggle'
                call s:LspFeatureToggleAll()
                return
            endif
            for l:name in l:names
                let g:vimrc_lsp[l:name] = l:arg ==# 'toggle'
                            \ ? !get(g:vimrc_lsp, l:name, 1) : l:arg ==# 'on'
                if get(g:, 'lsp_user_enabled', 0)
                    call s:LspFeatureApply(l:name)
                endif
            endfor
            if len(l:names) == 1
                let l:state = g:vimrc_lsp[l:names[0]] ? 'on' : 'off'
                if get(g:, 'lsp_user_enabled', 0)
                            \ && !s:LspFeatureSupported(l:names[0])
                    let l:state .= ' (not supported in this editor)'
                endif
                echo 'LSP ' . l:names[0] . '=' . l:state
                            \ . (get(g:, 'lsp_user_enabled', 0) ? ''
                            \ : ' (applies when LSP starts: <leader>Le)')
            else
                echo s:LspFeatureStatus()
            endif
        endfunction
        " All features off when any is on (their states are remembered),
        " else back to the remembered states (all on if none remembered)
        function! s:LspFeatureToggleAll() abort
            let l:any_on = !empty(filter(copy(s:lsp_feature_names),
                        \ 'get(g:vimrc_lsp, v:val, 1)'))
            if l:any_on
                let s:lsp_features_saved = copy(g:vimrc_lsp)
            endif
            let l:saved = get(s:, 'lsp_features_saved', {})
            for l:name in s:lsp_feature_names
                let g:vimrc_lsp[l:name] = l:any_on ? 0 : get(l:saved, l:name, 1)
            endfor
            if !l:any_on
                unlet! s:lsp_features_saved
            endif
            if get(g:, 'lsp_user_enabled', 0)
                for l:name in s:lsp_feature_names
                    call s:LspFeatureApply(l:name)
                endfor
            endif
            echo (l:any_on ? 'LSP features all off (<leader>LT restores them; '
                        \ . 'servers and LSP keys stay)' : s:LspFeatureStatus())
        endfunction
        function! s:LspFeatureComplete(arglead, cmdline, cursorpos) abort
            let l:args = split(a:cmdline)
            let l:n = len(l:args) - (a:arglead ==# '' ? 0 : 1)
            let l:list = l:n <= 1 ? s:lsp_feature_names + ['all']
                        \ : ['on', 'off', 'toggle']
            return filter(copy(l:list), 'v:val =~# "^" . a:arglead')
        endfunction
        command! -bar -nargs=* -complete=customlist,s:LspFeatureComplete LspFeature
                    \ call s:LspFeatureCmd(<f-args>)
        for [s:key, s:name] in [['d', 'diagnostics'], ['v', 'virtual_text'],
                    \ ['c', 'completion'], ['s', 'signature'],
                    \ ['r', 'references'], ['a', 'code_action'],
                    \ ['i', 'inlay_hints'], ['p', 'doc_preview']]
            execute 'nnoremap <silent> <leader>Lt' . s:key
                        \ . ' :<C-u>LspFeature ' . s:name . '<CR>'
        endfor
        unlet s:key s:name
        nnoremap <silent> <leader>Ltt :<C-u>LspFeature<CR>
        nnoremap <silent> <leader>Lto :<C-u>LspFeature all on<CR>
        nnoremap <silent> <leader>LT  :<C-u>LspFeature all<CR>

" Vim-LSP keys and buffer setup ----------------------------------------------
        " Manage LSP server
        nmap <leader>LM :LspManageServers<CR>
        nmap <leader>LI :LspInstallServer<CR>
        nmap <leader>LS :LspStopServer<space>
        " lsp#disable(), with a work-around for a vim-lsp bug: completion
        " documentation and code action signs keep their 's:enabled' flag
        " after _disable(), so the next lsp#enable() skips them (no doc
        " float next to the completion menu, no 'A>' signs after
        " <leader>Lp/Ld/LR then <leader>Le). Sourcing the two files again
        " resets the flag (their top level only sets state and highlights).
        function! s:LspDisable() abort
            call lsp#disable()
            runtime autoload/lsp/internal/completion/documentation.vim
            runtime autoload/lsp/internal/document_code_action/signs.vim
        endfunction
        " Restart: stop all servers (!), then re-enable vim-lsp, which starts
        " servers again for every loaded buffer (vim-lsp API, vim + neovim)
        nmap <leader>LR :LspStopServer!<CR>
                    \:call <SID>LspDisable()<CR>:call EnableLSP()<CR>
        " Show LSP server status
        nmap <leader>Ls :LspStatus<CR>
        " Enable / pause / stop LSP (in all buffers)
        " -- Lp: pause, Vim's own keys back, servers keep running (Le is instant)
        " -- Ld: stop, Vim's own keys back and all servers shut down
        nmap <leader>Le :call EnableLSP()<CR>
        nmap <leader>Lp :call DisableLSP(0)<CR>
        nmap <leader>Ld :call DisableLSP(1)<CR>
        " Use the project's virtualenv for language servers (and :terminal,
        " :!, vim-test) when none is active (same as :ProjectVenv)
        " -- Looks for .venv, venv, env with bin/python at the project root
        function! s:ActivateProjectVenv() abort
            if empty($VIRTUAL_ENV) && !empty(ProjectVenv())
                        \ && VenvActivate(ProjectVenv())
                echomsg 'Activated virtualenv: ' . $VIRTUAL_ENV
            endif
        endfunction
        " Enable LSP
        " -- Features follow g:vimrc_lsp (:LspFeature, <leader>Lt*)
        function! EnableLSP() abort
            call s:ActivateProjectVenv()
            let g:lsp_user_enabled = 1
            call s:LspFeaturesRegister()
            call lsp#enable()
            for l:name in s:lsp_feature_names
                call s:LspFeatureApply(l:name)
            endfor
            " Index words of all loaded buffers for buffer-word completion
            for l:buf in getbufinfo({'buflisted': 1, 'bufloaded': 1})
                call s:BufferWordsRefresh(l:buf.bufnr)
            endfor
            " LSP keys come from s:on_lsp_buffer_enabled(): vim-lsp fires
            " lsp_buffer_enabled for every loaded buffer with a server (also
            " after <leader>Ld, as the servers are still running)
            let g:vimrc_lsp_paused = 0
        endfunction
        " Buffer-local keys and options set by s:on_lsp_buffer_enabled()
        let s:lsp_buffer_keys = [
                    \ ['n', 'K'], ['n', 'gd'], ['n', 'g/'], ['n', 'g?'],
                    \ ['n', 'gr'], ['n', 'gi'], ['n', 'gy'], ['n', '[g'],
                    \ ['n', ']g'], ['n', '<M-e>'], ['n', '<M-y>'], ['n', '<M-G>'],
                    \ ['n', '<M-g>'], ['i', '<M-e>'], ['i', '<M-y>'],
                    \ ['i', '<M-G>'], ['i', '<M-g>'], ['i', '<CR>'],
                    \ ['n', '<leader>ee'], ['n', '<leader>re'],
                    \ ['n', '<leader>Lf'], ['x', '<leader>Lf'],
                    \ ['n', '<leader>La'], ['x', '<leader>La']]
        " Remember the buffer's own mappings for those keys (e.g. auto-pairs'
        " <CR>) and its omnifunc/tagfunc, once, before LSP replaces them
        function! s:LspBufferSave() abort
            if exists('b:vimrc_lsp_saved')
                return
            endif
            let l:maps = {}
            for [l:mode, l:lhs] in s:lsp_buffer_keys
                let l:map = maparg(l:lhs, l:mode, 0, 1)
                if !empty(l:map) && get(l:map, 'buffer', 0)
                    let l:maps[l:mode . l:lhs] = l:map
                endif
            endfor
            let b:vimrc_lsp_saved = { 'maps': l:maps,
                        \ 'omnifunc': &l:omnifunc,
                        \ 'tagfunc': exists('+tagfunc') ? &l:tagfunc : '' }
        endfunction
        " Give the current buffer its own keys back: Vim defaults (K =
        " 'keywordprg', gd, gi, gr, ...) or the buffer's earlier mappings
        " -- Only keys that still have the LSP mapping: a plugin may have
        "    mapped over it since (auto-pairs wraps <CR> in buffers opened
        "    while LSP is on), and that mapping is kept
        function! s:LspBufferRestore() abort
            let b:vimrc_lsp_restore = 0
            if get(g:, 'lsp_user_enabled', 0) || !exists('b:vimrc_lsp_saved')
                return
            endif
            let l:mapped = get(b:, 'vimrc_lsp_mapped', {})
            for [l:mode, l:lhs] in s:lsp_buffer_keys
                let l:key = l:mode . l:lhs
                if !has_key(l:mapped, l:key)
                            \ || maparg(l:lhs, l:mode) !=# l:mapped[l:key]
                    continue
                endif
                execute 'silent! ' . l:mode . 'unmap <buffer> ' . l:lhs
                if has_key(b:vimrc_lsp_saved.maps, l:key)
                    call mapset(l:mode, 0, b:vimrc_lsp_saved.maps[l:key])
                endif
            endfor
            unlet! b:vimrc_lsp_mapped
            let &l:omnifunc = b:vimrc_lsp_saved.omnifunc
            if exists('+tagfunc')
                let &l:tagfunc = b:vimrc_lsp_saved.tagfunc
            endif
            unlet b:vimrc_lsp_saved
            let b:vimrc_lsp_buffer = 0
        endfunction
        " Hidden buffers are restored when they are entered next
        autocmd vimrc BufEnter *
                    \ if get(b:, 'vimrc_lsp_restore', 0)
                    \ | call s:LspBufferRestore() | endif
        " Pause (stop = 0) or stop (stop = 1) LSP in all buffers
        " -- Both: vim-lsp off (no diagnostics, completion, highlights), LSP
        "    keys removed so Vim's own keys work again, AutoComplPop back
        " -- Pause keeps the servers running; nothing is sent to them until
        "    <leader>Le, which re-sends changed files first
        " -- signcolumn=auto (set globally) hides the column once signs are gone
        function! DisableLSP(stop) abort
            let g:lsp_user_enabled = 0
            call s:LspDisable()
            if a:stop
                silent LspStopServer!
            endif
            let g:vimrc_lsp_paused = !a:stop
            " Restore keys now in buffers shown in a window, on BufEnter in
            " the others
            for l:buf in getbufinfo({'bufloaded': 1})
                if has_key(l:buf.variables, 'vimrc_lsp_saved')
                    call setbufvar(l:buf.bufnr, 'vimrc_lsp_restore', 1)
                    if !empty(l:buf.windows)
                        call win_execute(l:buf.windows[0],
                                    \ 'call s:LspBufferRestore()')
                    endif
                endif
            endfor
            " Let autocomplpop pop up again in buffers that LSP had taken over
            for l:buf in getbufinfo()
                call setbufvar(l:buf.bufnr, 'vimrc_lsp_buffer', 0)
                if getbufvar(l:buf.bufnr, 'lsp_acp_off', 0)
                    call setbufvar(l:buf.bufnr, 'asyncomplete_enable', 0)
                    call setbufvar(l:buf.bufnr, 'acp_off', 0)
                    call setbufvar(l:buf.bufnr, 'lsp_acp_off', 0)
                endif
            endfor
            if exists('*s:AcpBufferSync')
                call s:AcpBufferSync()
            endif
            echo a:stop ? 'LSP stopped: servers shut down, Vim keys restored'
                        \ : 'LSP paused: Vim keys restored, servers still running'
                        \ . ' (<leader>Le resumes, <leader>Ld stops them)'
        endfunction
        " Load LSP settings and keybindings
        function! s:on_lsp_buffer_enabled() abort
            " vim-lsp also fires this on the first BufEnter of a buffer it
            " opened earlier; LSP may be paused or stopped by then
            if !get(g:, 'lsp_user_enabled', 0)
                return
            endif
            let b:vimrc_lsp_restore = 0
            call s:LspBufferSave()
            " LSP settings
            setlocal omnifunc=lsp#complete
            if exists('+tagfunc') | setlocal tagfunc=lsp#tagfunc | endif
            " LSP keybindings
            nmap <buffer> K  <plug>(lsp-hover)
            nmap <buffer> gd <plug>(lsp-definition)
            nmap <buffer> g/ <plug>(lsp-document-symbol-search)
            nmap <buffer> g? <plug>(lsp-workspace-symbol-search)
            nmap <buffer> gr <plug>(lsp-references)
            nmap <buffer> gi <plug>(lsp-implementation)
            nmap <buffer> gy <plug>(lsp-type-definition)
            nmap <buffer> [g <plug>(lsp-previous-diagnostic)
            nmap <buffer> ]g <plug>(lsp-next-diagnostic)
            " Scroll the LSP float/popup without entering it: hover (K) in
            " normal mode, completion docs and argument hint in insert mode
            " -- Alt+e/y: down/up 4 lines, Alt+G/g: end/start
            " -- (a 2nd K does not focus the float: it closes it in neovim
            "    and vim popups cannot be focused)
            for s:mode in ['n', 'i']
                execute s:mode . 'noremap <buffer><expr> <M-e> lsp#scroll(+4)'
                execute s:mode . 'noremap <buffer><expr> <M-y> lsp#scroll(-4)'
                execute s:mode . 'noremap <buffer><expr> <M-G> lsp#scroll(+100000)'
                execute s:mode . 'noremap <buffer><expr> <M-g> lsp#scroll(-100000)'
            endfor
            " Load LSP diagnostics to location list
            nmap <buffer> <leader>ee :LspDocumentDiagnostics<CR>
            " Rename variable
            nmap <buffer> <leader>re <plug>(lsp-rename)
            " Format w/ LSP server
            " -- normal: whole file; visual: selection
            nmap <buffer> <leader>Lf :LspDocumentFormatSync<CR>
            xmap <buffer> <leader>Lf <plug>(lsp-document-range-format)
            " Code action (quick fix, organize imports, ...) [a for action]
            nmap <buffer> <leader>La <plug>(lsp-code-action)
            xmap <buffer> <leader>La :LspCodeAction<CR>
            " Close pop-up window without opening a new line
            " -- <buffer>: only in LSP buffers. auto-pairs also maps <CR> per
            "    buffer, so keep its newline handling (AutoPairsReturn)
            if exists('*AutoPairsReturn') && exists('b:autopairs_enabled')
                inoremap <buffer><silent><expr> <CR> pumvisible()
                            \ ? asyncomplete#close_popup()
                            \ : "\<CR>\<C-r>=AutoPairsReturn()\<CR>"
            else
                inoremap <buffer><expr> <CR>
                            \ pumvisible() ? asyncomplete#close_popup() : "\<CR>"
            endif
            " What LSP mapped, so <leader>Lp/Ld remove only these
            let b:vimrc_lsp_mapped = {}
            for [l:mode, l:lhs] in s:lsp_buffer_keys
                let b:vimrc_lsp_mapped[l:mode . l:lhs] = maparg(l:lhs, l:mode)
            endfor
            " Diagnostics and completion as set by :LspFeature (completion
            " on: asyncomplete pops up here and autocomplpop pauses)
            let b:vimrc_lsp_buffer = 1
            call s:LspFeatureApplyBuffer(bufnr(''))
            call s:BufferWordsRefresh(bufnr(''))
            if exists('*s:AcpBufferSync')
                call s:AcpBufferSync()
            endif
        endfunction
        " Install LSP server
        augroup lsp_install
            au!
            " call s:on_lsp_buffer_enabled only for languages that has the server registered.
            autocmd User lsp_buffer_enabled call s:on_lsp_buffer_enabled()
        augroup END
    endif

