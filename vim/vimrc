" ============================================================================
" Vim and Neovim settings (***MUST-READ SECTION***)
" ============================================================================
" Everything you may want to change lives here, in four dictionaries:
" -- g:vimrc_features : feature switches (1 = load the plugins AND their
"                       settings/keys, 0 = drop the whole group)
" -- g:vimrc_paths    : directories (computed once, absolute)
" -- g:vimrc_tools    : external programs, scripts and tool settings
" -- g:vimrc_tmux     : tmux pane integration
" Conventions used in the rest of this file:
" -- Conditions:  if s:on('lsp') ... endif
" -- Values:      g:vimrc_features.fancy_symbols, g:vimrc_paths.templates, ...
"                 (also inside mappings, which run outside this script)
" -- Plugin options (g:<plugin>_...) are set in the plugin's own section,
"    from these dictionaries, never here.
" -- Machine-specific values go in vim/local.vim (untracked, optional,
"    see vim/local.vim.example). It is sourced first; any key it sets in the
"    dictionaries below overrides the default (one level deep: a nested
"    dict such as g:vimrc_tools.ollama must be given in full).

" Encoding (must come before any non-ASCII text in this file) ----------------
    " Neovim is always utf-8; for vim this also sets how this file is read
    set encoding=utf-8
    scriptencoding utf-8

" Editor detection (computed, not set by hand) -------------------------------
    " Not compatible with vi [No need for neovim, which is always nocompatible]
    " -- MUST be the first option: setting 'nocompatible' resets other options
    "    (e.g. shortmess, cpoptions) to Vim defaults, which would undo any
    "    option set before it. Also enables line continuation (\) below.
    if !has('nvim')
        set nocompatible
    endif
    " Neovim (1) or vim (0)
    let g:vimrc_is_nvim = has('nvim')
    " Vim >= 8.0 or neovim >= 0.5: terminal, polyglot, LSP, markdown preview
    let g:vimrc_is_vim8 = has('nvim-0.5') || (!has('nvim') && v:version >= 800)

" Configuration directory and local overrides --------------------------------
    " Directory of this vimrc (.../Vim_Tmux_Config/vim), symlinks resolved.
    " -- When this file was copied (e.g. to ~/.vimrc) instead of symlinked,
    "    fall back to the usual clone location.
    " (resolve the file, not its directory: ~/.vimrc -> .../vim/vimrc)
    let s:vimrc_dir = fnamemodify(resolve(expand('<sfile>:p')), ':h')
    if !isdirectory(s:vimrc_dir . '/share/templates')
        let s:vimrc_dir = expand('$HOME/Desktop/Vim_Tmux_Config/vim')
    endif
    " Optional machine-specific overrides (git-ignored)
    if filereadable(s:vimrc_dir . '/local.vim')
        execute 'source' fnameescape(s:vimrc_dir . '/local.vim')
    endif

" Feature switches -----------------------------------------------------------
    " -- theme             : colorschemes + lightline status/tab line
    " -- fancy_symbols     : nerd-font icons (lightline, nerdtree)
    " -- wal_theme         : pywal (Xresources) colors, cterm only
    " -- extra             : vimwiki, goyo, startify, yankring, easymotion,
    "                        peekaboo, markbar, autocomplpop, hexokinase, ...
    " -- coding            : polyglot, neoformat, git tools, indent guides,
    "                        multi-cursor, dadbod
    " -- lsp               : vim-lsp (servers start only on <leader>Le)
    " -- python_tools      : vim-test (<leader>pt*) and vimspector (<leader>D*)
    " -- gui_apps          : external viewers (browser preview, zathura)
    " -- format_on_save    : run Neoformat on save for python, sh, lua, json,
    "                        yaml, toml (needs 'coding'; per buffer: <leader>Tf)
    " -- auto_session      : inside tmux, keep a Session.vim (:Obsess) in the
    "                        git root vim was started in, so tmux-resurrect
    "                        restores vim splits/tabs after a reboot
    " -- python_skeleton, tex_template, bash_template, markdown_template :
    "                        template inserted into newly created files
    " NOTE: no trailing "comments inside \-continued lines (they break the
    "       statement), so the descriptions are above.
    let g:vimrc_features = extend({
                \ 'theme': 1, 'fancy_symbols': 0, 'wal_theme': 0,
                \ 'extra': 1, 'coding': 1, 'lsp': 1, 'python_tools': 1,
                \ 'gui_apps': 1, 'python_skeleton': 1, 'tex_template': 1,
                \ 'bash_template': 1, 'markdown_template': 0,
                \ 'format_on_save': 0, 'auto_session': 1,
                \ }, get(g:, 'vimrc_features', {}))
    " Derived (not a switch): legacy deoplete/jedi completion when LSP is off
    let g:vimrc_features.legacy_python_completion = !g:vimrc_features.lsp
    " Feature test used in conditions below
    function! s:on(feature) abort
        return get(g:vimrc_features, a:feature, 0)
    endfunction

" Paths ----------------------------------------------------------------------
    " -- vim            : this directory (vim/ in the repository)
    " -- templates      : templates for new files (skeleton.py, ...)
    " -- bin            : helper scripts
    " -- wiki           : vimwiki root (notes, diary)
    " -- wiki_templates : note templates (vim-markdown-tools)
    let g:vimrc_paths = extend({
                \ 'vim': s:vimrc_dir,
                \ 'templates': s:vimrc_dir . '/share/templates/',
                \ 'bin': s:vimrc_dir . '/bin/',
                \ 'wiki': expand('~/Documents/KNOWLEDGE_BASE/'),
                \ }, get(g:, 'vimrc_paths', {}))
    let g:vimrc_paths.wiki_templates = get(g:vimrc_paths, 'wiki_templates',
                \ g:vimrc_paths.wiki . 'resources/template/')

" External tools -------------------------------------------------------------
    " -- browser            : markdown preview ($BROWSER)
    " -- python3_host       : python for neovim/vim python plugins (pynvim)
    " -- python_lsp_servers : vim-lsp-settings servers (:LspInstallServer)
    " -- python_debugger    : <leader>pB (ipdb if installed, else pdb)
    " -- languagetool_jar   : LanguageTool command-line jar
    " -- ollama             : vim-ai endpoint/model (local Ollama)
    " -- vimwiki_ctags, mdformat_patch, jrnl_collect : helper scripts in bin/
    let g:vimrc_tools = extend({
                \ 'browser': $BROWSER,
                \ 'python3_host': '/usr/bin/python',
                \ 'python_lsp_servers': ['pylsp-all'],
                \ 'python_debugger': executable('ipdb3') || executable('ipdb')
                \                    ? 'ipdb' : 'pdb',
                \ 'languagetool_jar':
                \     '/opt/LanguageTool-5.9/languagetool-commandline.jar',
                \ 'ollama': {
                \     'url': 'http://localhost:11434/v1/chat/completions',
                \     'model': 'gemma4:e2b', 'temperature': 0.3,
                \     'num_ctx': 8192 },
                \ 'llamacpp': {
                \     'url': 'http://localhost:8081/v1/chat/completions',
                \     'model': 'local-llamacpp', 'temperature': 0.3,
                \     'num_ctx': 131072 },
                \ 'vimwiki_ctags': g:vimrc_paths.bin . 'vwtags.py',
                \ 'mdformat_patch': g:vimrc_paths.bin . 'mdformat_patch.py',
                \ 'jrnl_collect': g:vimrc_paths.bin . 'collect_jrnl_journal.py',
                \ }, get(g:, 'vimrc_tools', {}))
    " Python provider must be known before plugins load
    let g:python3_host_prog = g:vimrc_tools.python3_host

" Tmux integration -----------------------------------------------------------
    " -- target        : pane for <leader>x (send), <leader>xd (diagnostics)
    "                    and <leader>qt (capture); '{last}' = previously
    "                    active pane, change it with <leader>xt
    " -- run_target    : pane for vim-test (<leader>pt*) and <leader>px/pl
    "                    (run file); '' = same as target, change it with
    "                    <leader>xT. Commands are only sent when that pane
    "                    runs a shell, never into an agent or REPL prompt.
    " -- capture_lines : scrollback lines read by <leader>qt
    let g:vimrc_tmux = extend({
                \ 'target': '{last}', 'run_target': '', 'capture_lines': 300,
                \ }, get(g:, 'vimrc_tmux', {}))

" LSP features ---------------------------------------------------------------
    " State of each LSP feature when LSP starts (<leader>Le). All on; switch
    " any of them off/on later while LSP runs, without restarting servers:
    " :LspFeature [name [on|off|toggle]] or <leader>Lt* (see Part 9)
    " -- diagnostics  : lint results (signs, underline, ]g/[g, <leader>ee)
    " -- virtual_text : diagnostic message at the end of the line
    " -- completion   : asyncomplete pop-up (off: AutoComplPop, <C-x><C-o>)
    " -- signature    : function argument hint while typing ( and ,
    " -- references   : highlight other uses of the word under the cursor
    " -- code_action  : 'A>' sign where a code action is available
    " -- inlay_hints  : inline type/parameter hints (vim 9 only, not neovim)
    " -- doc_preview  : documentation float next to the completion menu
    "                   (function signature + docstring of the selected item)
    let g:vimrc_lsp = extend({
                \ 'diagnostics': 1, 'virtual_text': 1, 'completion': 1,
                \ 'signature': 1, 'references': 1, 'code_action': 1,
                \ 'inlay_hints': 1, 'doc_preview': 1,
                \ }, get(g:, 'vimrc_lsp', {}))

" TERMGUI color --------------------------------------------------------------
    " Ctermcolors only support max 256 color
    " Termguicolors can support HTML color code

    " Wal colortheme does not work well with termguicolors
    if has('termguicolors') && !s:on('wal_theme')
        set termguicolors
    endif
    " 256 term color support in vim TUI
    if !has('gui_running')
        set t_Co=256
    endif

" ============================================================================
" Vim built-in function settings and vim hotkeys settings
" ============================================================================
" All parameter settings and hotkey mappings
    " NOTE:
    " -- Ctrl+i (Tab)
    " -- Ctrl+[j/m] (Enter)

" Vim built-in filetype setting ----------------------------------------------
    " Following settings are later automatically executed by VIM-plug
    " -- filetype plugin on
    " -- filetype indent on
    " -- syntax enable
    filetype off

" Set leaderkey --------------------------------------------------------------
    " Default leaderkey '\'
    let mapleader = ' '

" Vimrc autocommand group ----------------------------------------------------
    " All autocommands in this file are registered with 'autocmd vimrc ...'.
    " The group is cleared here, so sourcing this file again (e.g. :source
    " $MYVIMRC) does not register every autocommand a second time.
    augroup vimrc
        autocmd!
    augroup END

" Map insert mode key --------------------------------------------------------
    " NOTE:
    " -- Ctrl+o: Execute single normal mode operation
    " -- Ctrl+r+(register): Paste register
    " -- Ctrl+[n/p]: Autocompletion next/prev candidate
    " -- Ctrl+[d/t]: Unindent/Indent current line
    " -- Ctrl+[q/v]: Insert-special-keys mode
    "    -- Usage: insert u2713 to insert unicode character u+2713

    " Map exit insert mode (Esc/Ctrl+[) to kj (ii is disabled)
    " -- Use Ctrl+[q/v] to escape for 'ii' word (e.g. ascii)
    "imap ii <Esc>
    imap kj <Esc>
    " <C-g>u: add break point for text-writing undo
    " -- e.g. w/o bp: test,test,test --undo->
    " -- e.g. w/i bp: test,test,test --undo-> test,test,
    inoremap , ,<C-g>u
    inoremap . .<C-g>u
    inoremap ? ?<C-g>u
    inoremap ! !<C-g>u
    " Insert date/date+time in insert mode (<C-g>s/S are vim-surround)
    inoremap <C-g>d <C-r>=strftime('%F')<CR>
    inoremap <C-g>t <C-r>=strftime('%Y-%m-%d %H:%M:%S')<CR>

" Map normal/visual/operator-pending mode key --------------------------------
    " NOTE:
    " -- z+[t/z/b/h/l]: scroll window top/center/bottom/left/right
    " -- :ju[mps]: show all jump history
    " -- Ctrl+[i/o]: jump to next/prev cursor location
    " -- :changes: show all change history
    " -- g+[;/,]: go to older/newer change
    " -- g+[-/+]: go to prev/next text-states (undo/redo)
    " -- g+[j/k/l/h]: move in visual lines instead of real lines in WRAP text
    " -- g+[uu/UU/~~]: set lowercase/uppercase/toggle for whole line
    " -- g+[t/T]: go to next/prev tab
    " -- g+[i]: go to last location in insert mode and enter insert mode
    " -- g+[v]: go to last location in visual mode and enter visual mode
    " -- g+[n]: go to next search and visually select it
    " -- g+[f/x]: go to file/URL
    " -- g+[*/#]: like */# but also find matches that are not a whole word
    " -- g+Ctrl+g: count words
    " -- :g/PATTERN/ACTION: in entire file, for lines matched PATTERN, do ACTION
    " -- :v/PATTERN/ACTION: in entire file, for lines do not matched PATTERN, do ACTION
    " -- o: jump between both ends of selection in visual mode
    "    -- jumps: ', `, G, /, ?, n, N, %, (, ), [[, ]], {, }, :s, :tag, L, M, H
    "    -- also jumps: commands that start editing a new file.
    " -- q:: open command line history
    " -- q/: open search history
    " -- :<C-f>: open command mode history
    " -- /<C-f>: open search history

    " Unmap keys to prevent entering ex mode by typo
    map gQ <nop>
    nnoremap Q <nop>
    " Make Y yank to the EOL instead of whole line just like what D does
    nnoremap Y y$
    " Stop delete/change/replace overwriting current register
    " -- x uses the black-hole register: with clipboard=unnamedplus, x would
    "    otherwise replace the system clipboard (e.g. text copied from a
    "    browser or agent). Visual-mode x still cuts as usual.
    "nnoremap d "_d
    nnoremap x "_x
    " NOTE: r (replace char) never writes to a register, so no mapping needed
    "nnoremap r "_r
    " Move selection block up/down in visual mode
    vnoremap K :move '<-2<CR>gv=gv
    vnoremap J :move '>+1<CR>gv=gv
    " Tab is already mapped to <C-i> by vim
    noremap <Tab> <C-i>
    noremap <S-Tab> <C-o>
    " Show jump list
    nnoremap <leader><Tab> :jumps<CR>
    nnoremap <leader><S-Tab> :jumps<CR>
    " Show change list
    " -- Replaced by the fzf version (Part 3, 'FZF replacement'); the old
    "    one only remained in visual mode, where it fails (E481), so it is off
    "noremap <leader>g; :changes<CR>
    "noremap <leader>g, :changes<CR>
    " Diff mode (vimdiff or nvim -d)
    nnoremap <leader>dd :diffthis<CR>
    nnoremap <leader>dD :diffoff<CR>
    nnoremap <leader>ds :diffsplit<space>
    nnoremap <leader>dv :vertical diffsplit<space>
    noremap <leader>do :diffget<space>
    noremap <leader>dp :diffput<space>
    nnoremap <leader>du :diffupdate<CR>
    noremap <leader>dj ]c
    noremap <leader>dk [c
    " Inline substitution (press & to repeat last substitution action)
    noremap gs :s/<c-r><c-w>//g<left><left>
    noremap gS :s/\<<c-r><c-w>\>//g<left><left>
    " Insert date (to date/to sec)
    nnoremap <leader>idd <Esc>i<C-r>=strftime('%F')<CR>
    nnoremap <leader>ids <Esc>i<C-r>=strftime('%Y-%m-%d %H:%M:%S')<CR>
    " Copy current file path to clipboard
    " -- @+ is CLIPBOARD (Ctrl+Shift+V in terminal, e.g. paste into an agent
    "    pane), @* is PRIMARY (middle click). Set both to cover both pastes.
    nnoremap <leader>yp :let @+ = expand('%:p') <bar> let @* = @+ <bar> echo 'Yanked path: ' . @+<CR>
    " Copy file reference for agent prompts: @path:L12 (visual: @path:L12-L30)
    " -- Path is relative to the project (git) root, where the agent runs;
    "    a path with spaces is quoted: @"my dir/a.py":L12 (same as <leader>xr)
    nnoremap <silent> <leader>yr :<C-u>call <SID>YankRef(line('.'), line('.'))<CR>
    xnoremap <silent> <leader>yr :<C-u>call <SID>YankRef(line("'<"), line("'>"))<CR>

" Clipboard w/ xsel ----------------------------------------------------------
    " Use xsel as clipboard, it is recommended if
    " -- you see -clipboard in vim --version
    " -- you want to sync clipboard with remote SSH server using X-forward
    "vnoremap y :w !xsel -ib<CR><CR>
    "nnoremap yy :.w !xsel -ib<CR><CR>
    "nnoremap p :read !xsel -ob<CR>

" Save/Load file hotkey ------------------------------------------------------
    " NOTE:
    " -- ZZ (Quit and save if there's change in file without confirmation)
    " -- :f <new-filename> (Save current file with new filename)
    " -- :earlier Nf (Undo to last N file change)
    " -- :later Nf (Redo to N file change)
    " -- :w with sudo (same as :SudaWrite from lambdalisue/suda.vim)
    "command! W silent execute 'w !sudo tee ' . shellescape(expand('%')) . ' > /dev/null' | edit!

    nnoremap <leader>qq :q<CR>
    nnoremap <leader>q! :q!<CR>
    nnoremap <leader>qa :qall<CR>
    nnoremap <leader>qa! :qall!<CR>
    noremap <leader>ww :call RemoveTrailingWhitespace()<CR>:w<CR>
    noremap <leader>w! :call RemoveTrailingWhitespace()<CR>:w!<CR>
    noremap <leader>wq :call RemoveTrailingWhitespace()<CR>:wq<CR>
    " -- wa: write all and stay, wA: write all and quit, wa!: force write all
    nnoremap <leader>wa! :wall!<CR>
    nnoremap <leader>wa :wall<CR>
    nnoremap <leader>wA :wqall<CR>

" Macro ----------------------------------------------------------------------
    " NOTE:
    " Edit register visually [https://thoughtbot.com/blog/how-to-edit-an-existing-vim-macro]
    " -- 1. :let @q='
    " -- 2. <Ctrl-r><Ctrl-r>q
    " -- 3. Add closing quote ' and <Enter> to finish editing

    " Apply macro to all selected lines
    " -- From https://github.com/stoeffel/.dotfiles/blob/master/vim/visual-at.vim
    " -- Reference https://medium.com/@schtoeffel/you-don-t-need-more-than-one-cursor-in-vim-2c44117d51db
    function! ExecuteMacroOverVisualRange()
        echo "@".getcmdline()
        execute ":'<,'>normal @".nr2char(getchar())
    endfunction
    xnoremap @ :<C-u>call ExecuteMacroOverVisualRange()<CR>

" External command -----------------------------------------------------------
    " NOTE:
    " -- :r !date (Insert time stamp)
    " -- :r !seq [START] [INCREMENT] LAST (Insert number sequence)
    " -- :!dir (Show current directory file)
    " -- :!del FILENAME (Delete FILENAME)
    " -- :!column --table (Columnated selected context in visual mode)
    " -- :!sort (Sort selected context in visual mode alphabetically)

    " Add number sequence
    nnoremap <leader>esq :r !seq<space>
    " Add time stamp
    nnoremap <leader>ets :r !date<CR>
    " Sort selected context alphabetically
    vnoremap <leader>est :!sort<CR>
    " Filter out unique word [Context should be sorted first]
    vnoremap <leader>euq :!uniq<CR>

" General Vim settings -------------------------------------------------------
    " Project-local .vimrc/.exrc/.nvimrc in the current directory
    " -- Neovim >= 0.9 asks you to :trust each file before sourcing it
    " -- Vim: 'secure' only restricts files NOT owned by you, and files an
    "    agent writes in the project are owned by you, so exrc stays off
    if has('nvim-0.9')
        set exrc
    else
        set noexrc
    endif
    set secure          " Restrict commands in local exrc files (see :h secure)
    set timeoutlen=300  " Timeout for entering combined key (millisecond)
    set confirm         " Ask for confirmation before leaving vim
    set modifiable      " Make current buffer modifiable
    " NOTE: encoding/scriptencoding are set at the top of this file
    set notildeop       " Not make ~ a operator like gu, gU, and etc.
    set lazyredraw      " Only redraw when necessary.
    set shell=/bin/bash " Set default shell for vim/neovim (for navigator)
    set mouse=          " Disable mouse function
    set backspace=indent,eol,start     " Backspace through everything
    set clipboard^=unnamed,unnamedplus " Shared system clipboard (+clipboard)
    set virtualedit=none " Cursor can only be positioned where there is a char
    "set dictionary+=/usr/share/dict/words " Dictionary for word completion
    set tags=./.tags,.tags;/ " use ctag -o .tags -R . to generate file tags
    set updatetime=500  " Idle time (ms) for CursorHold: auto-reload of agent
                        " edits, gitgutter refresh, swap write (default 4000)
    set shortmess-=S    " Show search count [n/m] (replaces IndexedSearch)
    " Key-code timeout: how long Esc may wait for the rest of a key sequence
    " -- A terminal sends Alt+j as Esc followed by j. With the default (nvim 50
    "    ms, polyglot 100 ms), pressing Esc and then j/k quickly was read as
    "    <A-j>/<A-k> (resize window / completion keys), so the first j/k after
    "    leaving insert mode did not move and the window jumped. Real Alt keys
    "    arrive as one chunk (~0 ms), so 10 ms keeps them working.
    " -- tmux must not delay Esc either: 'escape-time 0' in tmux.conf
    set ttimeout ttimeoutlen=10
    if exists('+signcolumn')
        " Sign column only when a buffer has signs (LSP diagnostics,
        " gitgutter hunks, vimspector breakpoints); text shifts right by two
        " columns when the first sign appears. Use 'yes' to keep it always.
        set signcolumn=auto
    endif

