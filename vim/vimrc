" Function - git branch for statusline (without loading git plugins) --------
    " NOTE:
    " -- Runs 'git rev-parse --abbrev-ref HEAD' once per buffer (first time
    "    it is shown) and again when vim regains focus, e.g. after an agent
    "    switched branch/worktree in another tmux pane. Result is cached in
    "    b:lightline_git_branch. Detached HEAD shows 'HEAD'.
    function! LightlineGitbranchCache(force) abort
        if &buftype !=# '' || (!a:force && exists('b:lightline_git_branch'))
            return
        endif
        let l:dir = expand('%:p:h')
        if empty(l:dir) || !isdirectory(l:dir) || !executable('git')
            let b:lightline_git_branch = ''
            return
        endif
        let l:out = systemlist('git -C ' . shellescape(l:dir)
                    \ . ' rev-parse --abbrev-ref HEAD 2>/dev/null')
        let b:lightline_git_branch = v:shell_error ? '' : get(l:out, 0, '')
    endfunction
    if s:on('theme')
        autocmd vimrc BufEnter * call LightlineGitbranchCache(0)
        autocmd vimrc FocusGained * call LightlineGitbranchCache(1)
    endif

