" Better backup, swap and undos storage --------------------------------------
    " NOTE:
    " -- Trailing // makes vim build swap/backup names from the full path
    "    (e.g. %home%me%repo%pkg%__init__.py.swp), so files with the same
    "    name in different directories do not collide.
    " -- // in backupdir needs Vim >= 8.1.0251 or Neovim >= 0.5
    let s:BACKUP_FULLPATH = (has('nvim-0.5') || has('patch-8.1.0251')) ? '//' : ''
    if g:vimrc_is_nvim
        " Directory to place swap files
        set directory=~/.config/nvim/dirs/tmp//
        " Make backup files
        set backup
        " Where to put backup files
        let &backupdir = expand('~/.config/nvim/dirs/backups') . s:BACKUP_FULLPATH
        " Persistent undoes - undo after re-opening
        set undofile
        set undodir=~/.config/nvim/dirs/undos
        " Create needed directories if they don't exist
        if !isdirectory(&backupdir)
            call mkdir(&backupdir, 'p')
        endif
        if !isdirectory(&directory)
            call mkdir(&directory, 'p')
        endif
        if !isdirectory(&undodir)
            call mkdir(&undodir, 'p')
        endif
    else
        " Directory to place swap files
        set directory=~/.vim/dirs/tmp//
        " Make backup files
        set backup
        " Where to put backup files
        let &backupdir = expand('~/.vim/dirs/backups') . s:BACKUP_FULLPATH
        " Persistent undoes - undo after re-opening
        set undofile
        set undodir=~/.vim/dirs/undos
        " Create needed directories if they don't exist
        if !isdirectory(&backupdir)
            call mkdir(&backupdir, 'p')
        endif
        if !isdirectory(&directory)
            call mkdir(&directory, 'p')
        endif
        if !isdirectory(&undodir)
            call mkdir(&undodir, 'p')
        endif
    endif

