        "    (vim/share/templates/vimspector.json) to <project root>/.vimspector.json
        " -- <leader>D[b/c/n/i/o/r/q/e]: toggle breakpoint, continue (or start),
        "    step over/into/out, restart, quit (reset), evaluate word/selection
        " -- Lazy-loaded on the first <leader>D key or :Vimspector* command
        let s:VIMSPECTOR_TEMPLATE = g:vimrc_paths.templates . 'vimspector.json'
        function! s:VimspectorPythonConfig() abort
            let l:target = ProjectRoot() . '/.vimspector.json'
