" Function - project root (git executable only, no git plugin) ---------------
    " Returns the git top-level directory of the current file (or of the
    " working directory for unnamed buffers), or the working directory when
    " not inside a git repository. Used by <leader>qt, :FZFRgRoot and LSP.
    function! ProjectRoot() abort
        let l:dir = expand('%:p:h')
        if empty(l:dir) || !isdirectory(l:dir)
            let l:dir = getcwd()
        endif
        if executable('git')
            let l:out = systemlist('git -C ' . shellescape(l:dir)
                        \ . ' rev-parse --show-toplevel 2>/dev/null')
            if !v:shell_error && !empty(l:out) && isdirectory(l:out[0])
                return l:out[0]
            endif
        endif
        return getcwd()
    endfunction
    " Project virtualenv: .venv, venv or env with bin/python at the project
    " root, else ''. Used by LSP, vim-test and <leader>px.
    " -- In a git worktree without its own venv (e.g. an agent worktree), the
    "    main checkout's venv is used
    function! ProjectVenv() abort
        let l:root = ProjectRoot()
        let l:roots = [l:root]
        if executable('git')
            let l:common = trim(system('git -C ' . shellescape(l:root)
                        \ . ' rev-parse --path-format=absolute --git-common-dir 2>/dev/null'))
            if !v:shell_error && l:common =~# '/\.git$'
                let l:main = fnamemodify(l:common, ':h')
                if l:main !=# l:root
                    call add(l:roots, l:main)
                endif
            endif
        endif
        for l:dir in l:roots
            for l:name in ['.venv', 'venv', 'env']
                if executable(l:dir . '/' . l:name . '/bin/python')
                    return l:dir . '/' . l:name
                endif
            endfor
        endfor
        return ''
    endfunction
    " Activate/deactivate a virtualenv inside vim (no LSP needed)
    " -- Sets $VIRTUAL_ENV and puts <venv>/bin first in $PATH, so :!, :terminal,
    "    vim-test, <leader>px and language servers started afterwards use it
    " -- Language servers already running keep the old one: <leader>LR
    function! VenvActivate(venv) abort
        let l:venv = substitute(fnamemodify(a:venv, ':p'), '/\+$', '', '')
        if !executable(l:venv . '/bin/python')
            echohl WarningMsg | echo 'Not a virtualenv (no bin/python): '
                        \ . l:venv | echohl None
            return 0
        endif
        if $VIRTUAL_ENV ==# l:venv
            return 1
        endif
        call VenvDeactivate()
        let g:vimrc_venv_pinned = 0
        let $VIRTUAL_ENV = l:venv
        let $PATH = l:venv . '/bin:' . $PATH
        return 1
    endfunction
    function! VenvDeactivate() abort
        if empty($VIRTUAL_ENV)
            return 0
        endif
        let l:bin = $VIRTUAL_ENV . '/bin'
        let $PATH = join(filter(split($PATH, ':'), 'v:val !=# l:bin'), ':')
        let $VIRTUAL_ENV = ''
        silent! unlet $VIRTUAL_ENV
        return 1
    endfunction
    " :ProjectVenv        activate the project virtualenv (.venv/venv/env at
    "                     the git root), or show the active one
    " :ProjectVenv {dir}  activate that virtualenv (also used for tests and
    "                     <leader>px in every project until :ProjectVenv[!])
    " :ProjectVenv!       deactivate
    function! s:ProjectVenvCmd(bang, dir) abort
        let l:lsp_hint = get(g:, 'lsp_user_enabled', 0)
                    \ ? ' (restart LSP servers with <leader>LR to use it)' : ''
        if a:bang
            let l:old = $VIRTUAL_ENV
            echo VenvDeactivate() ? 'Deactivated virtualenv: ' . l:old . l:lsp_hint
                        \ : 'No virtualenv active'
            return
        endif
        let l:venv = empty(a:dir) ? ProjectVenv() : a:dir
        if empty(l:venv)
            echo (empty($VIRTUAL_ENV) ? 'No virtualenv active'
                        \ : 'Active virtualenv: ' . $VIRTUAL_ENV)
                        \ . '; no .venv/venv/env in ' . ProjectRoot()
            return
        endif
        let l:was = $VIRTUAL_ENV
        if VenvActivate(l:venv)
            " An explicitly chosen venv wins over the project's one for tests
            " and <leader>px (TmuxVenvPrefix)
            let g:vimrc_venv_pinned = !empty(a:dir)
            echo ($VIRTUAL_ENV ==# l:was ? 'Active virtualenv: '
                        \ : 'Activated virtualenv: ') . $VIRTUAL_ENV
                        \ . ($VIRTUAL_ENV ==# l:was ? '' : l:lsp_hint)
        endif
    endfunction
    command! -bar -bang -nargs=? -complete=dir ProjectVenv
                \ call s:ProjectVenvCmd(<bang>0, <q-args>)
    nnoremap <leader>pv :ProjectVenv<CR>
    nnoremap <leader>pV :ProjectVenv!<CR>

" Function - tmux pane output to quickfix list -------------------------------
    " NOTE:
    " -- <leader>qt reads the last g:vimrc_tmux.capture_lines lines of the tmux
    "    pane g:vimrc_tmux.target (default: last active pane, e.g. the agent or
    "    pytest pane) and puts every 'file:line[:col]' reference, Python
    "    traceback line ('File "x.py", line 42') and pdb frame into the
    "    quickfix list. Also understands '@file:L12' (from <leader>yr).
    " -- Only files that exist (relative to cwd or project root) are kept.
    "    Project files come first; library frames are dropped when there are
    "    project ones.
    " -- <leader>qT does the same with the run pane (test and <leader>px
    "    output): run_target, else a shell pane in vim's window
    " -- Then use <leader>qj/qk (or ]q/[q) to jump, <leader>qo to browse the
    "    list with fzf (:copen / :cclose open and close the window).
    function! s:TmuxPaneToQuickfix(which) abort
        if empty($TMUX) || !executable('tmux')
            echohl WarningMsg | echo 'Not inside tmux' | echohl None
            return
        endif
        if a:which ==# 'run'
            " The pane the last test/run went to (also while it sits at a
            " pdb prompt), else run_target, else a shell pane in vim's window
            let l:pane = get(s:, 'last_run_pane', '')
            if empty(l:pane) || empty(s:TmuxPaneCommand(l:pane))
                let l:pane = !empty(g:vimrc_tmux.run_target)
                            \ ? g:vimrc_tmux.run_target : s:TmuxFindRunPane(0)
            endif
            if empty(l:pane)
                echohl WarningMsg | echo 'No run pane yet (run a test, or <leader>xT)'
                echohl None
                return
            endif
        else
            let l:pane = g:vimrc_tmux.target
        endif
        let l:lines = systemlist('tmux capture-pane -p -J -S -'
                    \ . g:vimrc_tmux.capture_lines . ' -t ' . shellescape(l:pane))
        if v:shell_error
            echohl WarningMsg | echo 'tmux capture-pane failed: '
                        \ . join(l:lines) | echohl None
            return
        endif
        let l:root = ProjectRoot()
        " path (with or without extension, e.g. vim/vimrc) + :line[:col]
        let l:pat = '\v[~@`"''([]?\zs[[:alnum:]_./~-]*[[:alnum:]_-]:L?\d+%(:\d+)?'
        " Python traceback/logging: File "x.py", line 42
        let l:pat_tb = '\vFile "([^"]+)", line (\d+)'
        " pdb/ipdb current frame: > /path/x.py(42)func()
        let l:pat_pdb = '\v^\>\s+(\S+)\((\d+)\)'
        let l:pat_quoted = '\v\@"([^"]+)":L(\d+)'
        let l:items = []
        let l:seen = {}
        for l:line in l:lines
            let l:refs = []
            let l:start = 0
            while 1
                let l:ref = matchstr(l:line, l:pat, l:start)
                if empty(l:ref)
                    break
                endif
                let l:start = matchend(l:line, l:pat, l:start)
                let l:parts = matchlist(l:ref, '\v^(.{-}):L?(\d+)%(:(\d+))?$')
                call add(l:refs, l:parts[1:3])
            endwhile
            " Quoted @reference (path with spaces): @"my dir/a.py":L12
            let l:start = 0
            while 1
                let l:m = matchlist(l:line, l:pat_quoted, l:start)
                if empty(l:m)
                    break
                endif
                let l:start = matchend(l:line, l:pat_quoted, l:start)
                call add(l:refs, [l:m[1], l:m[2], ''])
            endwhile
            for l:p in [l:pat_tb, l:pat_pdb]
                let l:m = matchlist(l:line, l:p)
                if !empty(l:m)
                    call add(l:refs, [l:m[1], l:m[2], ''])
                endif
            endfor
            for [l:name, l:lnum, l:col] in l:refs
                let l:file = expand(l:name)
                if !filereadable(l:file) && filereadable(l:root . '/' . l:file)
                    let l:file = l:root . '/' . l:file
                endif
                let l:key = fnamemodify(l:file, ':p') . ':' . l:lnum
                if !filereadable(l:file) || has_key(l:seen, l:key)
                    continue
                endif
                let l:seen[l:key] = 1
                call add(l:items, { 'filename': l:file,
                            \ 'lnum': str2nr(l:lnum),
                            \ 'col': str2nr(l:col),
                            \ 'text': trim(l:line) })
            endfor
        endfor
        " Project files first; library frames (site-packages, stdlib) are
        " dropped when the output also points into the project, so the first
        " jump lands in your code, not in pytest or a library
        let l:lib = '\v/(site|dist)-packages/|/lib/python[0-9.]+/'
        let l:own = filter(copy(l:items), 'stridx(fnamemodify(v:val.filename, ":p"), l:root . "/") == 0 && v:val.filename !~# l:lib')
        if !empty(l:own)
            let l:items = l:own + filter(l:items,
                        \ 'index(l:own, v:val) < 0 && v:val.filename !~# l:lib')
        endif
        call setqflist([], ' ', { 'title': 'tmux ' . l:pane,
                    \ 'items': l:items })
        if empty(l:items)
            echo 'No file:line references found in tmux pane '
                        \ . l:pane
        else
            copen
            echo len(l:items) . ' references from tmux pane '
                        \ . l:pane
        endif
    endfunction
    nnoremap <silent> <leader>qt :<C-u>call <SID>TmuxPaneToQuickfix('target')<CR>
    nnoremap <silent> <leader>qT :<C-u>call <SID>TmuxPaneToQuickfix('run')<CR>

