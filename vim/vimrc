        " move the selection. Map the 4 keys back to themselves in fzf
        " buffers only, so they reach fzf instead of switching windows.
        autocmd vimrc FileType fzf
                    \ tnoremap <buffer> <C-h> <C-h>|
                    \ tnoremap <buffer> <C-j> <C-j>|
                    \ tnoremap <buffer> <C-k> <C-k>|
                    \ tnoremap <buffer> <C-l> <C-l>
    endif

" ============================================================================
" Send text to a tmux pane (REPL, test runner, agent prompt)
" ============================================================================
" Text is pasted with tmux bracketed paste (paste-buffer -p), so multi-line
" code arrives as one block in IPython, shells and agent prompts.
" Target pane: g:vimrc_tmux.target (default '{last}' = previously active pane)
    " NOTE:
    " -- <leader>xx: send current line / visual selection, then Enter
    " -- <leader>xc: send current '# %%' cell (IPython/Jupyter style), then
    "    move to the next cell (like Shift+Enter in VS Code interactive window)
    " -- xx/xc refuse a target pane running an agent (s:agents), so an Enter
    "    never answers its permission prompt; use <leader>xy there
    " -- <leader>xy: paste line/selection WITHOUT Enter (e.g. into an agent
    "    prompt, to edit before submitting)
    " -- <leader>xt: choose target pane (lists panes; '{last}', '%3', ':.1')
    " -- <leader>xT: choose run pane (tests and <leader>px/pl), see run_target
    " -- <leader>xd: paste the location list (LSP diagnostics after <leader>ee,
    "    or ALE) as '@file:L12: message' lines WITHOUT Enter (agent prompt)
    " -- <leader>xr: paste '@file:L12' (visual: '@file:L12-L30') WITHOUT Enter,
    "    like <leader>yr but straight into the target pane
    " -- Paths in @references are relative to the project root (git root)
    " -- A pane in copy mode (scrolled up) leaves it first, so Enter works
    " -- <leader>px: run current file in the run pane (python/sh/executable),
    "    from the project root, with the project virtualenv if any
    " -- <leader>pl: run the last <leader>px command again

    function! s:TmuxLeaveCopyMode(pane) abort
        if trim(system('tmux display-message -p -t ' . shellescape(a:pane)
                    \ . ' "#{pane_in_mode}"')) ==# '1'
            call system('tmux send-keys -t ' . shellescape(a:pane) . ' -X cancel')
        endif
    endfunction
    " Send text to target pane; enter = number of Enter keys after paste
    " -- Optional 3rd argument: pane (default g:vimrc_tmux.target)
    function! TmuxSendText(text, enter, ...) abort
        if empty($TMUX) || !executable('tmux')
            echohl WarningMsg | echo 'Not inside tmux' | echohl None
            return 0
        endif
        let l:pane = a:0 ? a:1 : g:vimrc_tmux.target
        let l:target = shellescape(l:pane)
        " Never press Enter in an agent pane: it could answer a permission
        " prompt (e.g. <leader>xx while the target is {last} = the agent)
        if a:enter > 0
            let l:prog = s:TmuxPaneCommand(l:pane)
            if index(s:agents, l:prog) >= 0
                echohl WarningMsg | echo 'tmux pane ' . l:pane . ' runs ' . l:prog
                            \ . ': not sent (no Enter into an agent; <leader>xy pastes without Enter)'
                echohl None
                return 0
            endif
        endif
        " Leave copy mode first, or the Enter below would only exit it
        call s:TmuxLeaveCopyMode(l:pane)
        call system('tmux load-buffer -b vim_send -', a:text)
        call system('tmux paste-buffer -d -p -b vim_send -t ' . l:target)
        if v:shell_error
            echohl WarningMsg | echo 'tmux: cannot paste to pane '
                        \ . l:pane | echohl None
            return 0
        endif
        for l:i in range(a:enter)
            call system('tmux send-keys -t ' . l:target . ' Enter')
        endfor
        return 1
    endfunction
    " Lines of the last visual selection (characterwise selection is cut to
    " the selected columns; blockwise is sent as whole lines)
    function! s:VisualSelectionText() abort
        let [l:l1, l:c1] = [line("'<"), col("'<")]
        let [l:l2, l:c2] = [line("'>"), col("'>")]
        let l:lines = getline(l:l1, l:l2)
        if visualmode() ==# 'v' && !empty(l:lines)
            let l:last = l:lines[-1]
            let l:c2 = l:c2 - 1 + len(matchstr(l:last, '\%' . l:c2 . 'c.'))
            let l:lines[-1] = l:last[: l:c2 - 1]
            let l:lines[0] = l:lines[0][l:c1 - 1 :]
        endif
        return join(l:lines, "\n")
    endfunction
    " Python blocks need an extra Enter when the last line is indented
    function! s:EnterCount(text) abort
        let l:nonblank = filter(split(a:text, "\n"), 'v:val =~# ''\S''')
        return !empty(l:nonblank) && l:nonblank[-1] =~# '^\s' ? 2 : 1
    endfunction
    " Send current '# %%' cell and jump to the next cell
    function! s:TmuxSendCell() abort
        let l:marker = '^\s*#\s*%%'
        let l:start = search(l:marker, 'bcnW')
        let l:end = search(l:marker, 'nW')
        let l:first = l:start ? l:start + 1 : 1
        let l:last = l:end ? l:end - 1 : line('$')
        let l:text = join(getline(l:first, l:last), "\n")
        if TmuxSendText(l:text, s:EnterCount(l:text)) && l:end
            call cursor(l:end + 1, 1)
        endif
    endfunction
    " Choose target pane (key: 'target' or 'run_target')
    function! s:TmuxChooseTarget(key) abort
        if empty($TMUX)
            echohl WarningMsg | echo 'Not inside tmux' | echohl None
            return
        endif
        echo join(systemlist('tmux list-panes -s -F "#{pane_id}  '
                    \ . '#{window_index}.#{pane_index}  #{pane_current_command}'
                    \ . '  #{pane_current_path}"'), "\n")
        let l:label = a:key ==# 'target' ? 'tmux target pane: '
                    \ : 'tmux run pane (empty = target pane): '
        let l:target = input(l:label, g:vimrc_tmux[a:key])
        if !empty(l:target) || a:key ==# 'run_target'
            let g:vimrc_tmux[a:key] = l:target
            if a:key ==# 'run_target'
                let s:run_auto = 0
                " <leader>qT reads the newly chosen pane, not the previous one
                unlet! s:last_run_pane
            endif
            redraw | echo l:label . g:vimrc_tmux[a:key]
        endif
    endfunction
    " Program running in a pane ('' when the pane does not exist, e.g. no
    " {last} pane yet or a closed pane)
    function! s:TmuxPaneCommand(pane) abort
        let l:prog = trim(system('tmux display-message -p -t '
                    \ . shellescape(a:pane) . ' "#{pane_current_command}"'))
        return v:shell_error ? '' : fnamemodify(l:prog, ':t')
    endfunction
    " Pane for commands (tests, run file): run_target, else target
    function! TmuxRunPane() abort
        return empty(g:vimrc_tmux.run_target) ? g:vimrc_tmux.target
                    \ : g:vimrc_tmux.run_target
    endfunction
    let s:shells = ['bash', 'zsh', 'fish', 'sh', 'dash', 'ksh', 'tcsh']
    " Coding agents (pane_current_command): text is pasted, never with Enter
    " -- 'node': Claude Code installed with npm shows as node
    let s:agents = ['claude', 'node', 'codex', 'aider', 'gemini']
    " A shell pane in vim's tmux window for commands: an idle shell pane
    " (not vim's own), else (split = 1) offer to split one below vim; '' if
    " none
    function! s:TmuxFindRunPane(split) abort
        for l:line in systemlist('tmux list-panes -t ' . shellescape($TMUX_PANE)
                    \ . ' -F "#{pane_id} #{pane_current_command}"')
            let [l:id, l:prog] = split(l:line . ' ?')[0:1]
            if l:id !=# $TMUX_PANE && index(s:shells, l:prog) >= 0
                return l:id
            endif
        endfor
        if !a:split
            return ''
        endif
        if confirm('No shell pane in this tmux window for tests/runs. Split one below vim?',
                    \ "&Yes\n&No", 1) != 1
            return ''
        endif
        let l:id = trim(system('tmux split-window -d -v -l 30% -t '
                    \ . shellescape($TMUX_PANE) . ' -c ' . shellescape(ProjectRoot())
                    \ . ' -P -F "#{pane_id}"'))
        if v:shell_error | return '' | endif
        sleep 400m
        return l:id
    endfunction
    " Send a shell command to the run pane, only if that pane runs a shell
    " (so a test command is never typed into an agent or REPL prompt)
    " -- run_target empty and the target pane is not a shell (e.g. the agent
    "    you used last) or does not exist (vim alone in its window): a shell
    "    pane in this window becomes the run pane (found, or split after
    "    asking) and is remembered in run_target
    " -- A run pane picked that way that was closed since is picked again;
    "    one you set with <leader>xT is never replaced
    function! TmuxRunCommand(cmd) abort
        if empty($TMUX) || !executable('tmux')
            echohl WarningMsg | echo 'Not inside tmux' | echohl None
            return 0
        endif
        if get(s:, 'run_auto', 0)
                    \ && empty(s:TmuxPaneCommand(g:vimrc_tmux.run_target))
            let g:vimrc_tmux.run_target = ''
            let s:run_auto = 0
        endif
        let l:pane = TmuxRunPane()
        let l:prog = s:TmuxPaneCommand(l:pane)
        if index(s:shells, l:prog) < 0
            let l:found = empty(g:vimrc_tmux.run_target) ? s:TmuxFindRunPane(1) : ''
            if empty(l:found)
                redraw
                echohl WarningMsg
                echo empty(l:prog) ? 'tmux: no pane ' . l:pane
                            \ . ': not sent (choose a pane with <leader>xT)'
                            \ : 'tmux pane ' . l:pane . ' runs ' . l:prog
                            \ . ', not a shell: not sent (choose a pane with <leader>xT)'
                echohl None
                return 0
            endif
            let g:vimrc_tmux.run_target = l:found
            let s:run_auto = 1
            let l:pane = l:found
            redraw
            echomsg 'Run pane: ' . l:pane . ' (change with <leader>xT)'
        endif
        " Clear a half-typed command at the prompt (end of line, kill to
        " start: bash, zsh, fish), so it is not glued to this one
        call s:TmuxLeaveCopyMode(l:pane)
        call system('tmux send-keys -t ' . shellescape(l:pane) . ' C-e C-u')
        let s:last_run_pane = l:pane
        return TmuxSendText(a:cmd, 1, l:pane)
    endfunction
    " Prefix that runs a command with a virtualenv, since the tmux pane's
    " shell does not have vim's: "env VIRTUAL_ENV=... PATH=.../bin:$PATH "
    " -- Order: a venv chosen with :ProjectVenv {dir}, else the current
    "    file's project venv (so repo B never runs with repo A's venv), else
    "    vim's active one
    function! RunVenv() abort
        if get(g:, 'vimrc_venv_pinned', 0) && !empty($VIRTUAL_ENV)
            return $VIRTUAL_ENV
        endif
        let l:venv = ProjectVenv()
        return empty(l:venv) ? $VIRTUAL_ENV : l:venv
    endfunction
    function! TmuxVenvPrefix() abort
        let l:venv = RunVenv()
        return empty(l:venv) ? '' : 'env VIRTUAL_ENV=' . shellescape(l:venv)
                    \ . ' PATH=' . shellescape(l:venv . '/bin') . ':"$PATH" '
    endfunction
    " Run the current file in the run pane, from the project root
    function! s:TmuxRunFile() abort
        if &buftype !=# '' || expand('%') ==# ''
            echohl WarningMsg | echo 'Not a file buffer' | echohl None
            return
        endif
        update
        let l:file = shellescape(expand('%:p'))
        if &filetype ==# 'python'
            let l:run = 'python3 ' . l:file
        elseif &filetype =~# '^\(sh\|bash\|zsh\)$'
            let l:run = (&filetype ==# 'sh' ? 'bash' : &filetype) . ' ' . l:file
        elseif executable(expand('%:p'))
            let l:run = l:file
        else
            echohl WarningMsg | echo 'Do not know how to run filetype '
                        \ . &filetype | echohl None
            return
        endif
        let s:last_run = 'cd ' . shellescape(ProjectRoot()) . ' && '
                    \ . TmuxVenvPrefix() . l:run
        call TmuxRunCommand(s:last_run)
    endfunction
    function! s:TmuxRunLast() abort
        if !exists('s:last_run')
            echo 'Nothing run yet (<leader>px runs the current file)'
            return
        endif
        call TmuxRunCommand(s:last_run)
    endfunction
    " Path for @references: relative to the project root (where the agent
    " runs), else ~-shortened absolute
    function! s:RefPath(path) abort
        let l:full = fnamemodify(a:path, ':p')
        let l:root = ProjectRoot()
        return stridx(l:full, l:root . '/') == 0 ? l:full[len(l:root) + 1 :]
                    \ : fnamemodify(l:full, ':~')
    endfunction
    " '@file:L12' / '@file:L12-L30'; a path with spaces is quoted:
    " '@"my dir/a.py":L12' (<leader>qt reads both forms back)
    function! s:FileRef(path, l1, l2) abort
        let l:path = s:RefPath(a:path)
        return '@' . (l:path =~# '\s' ? '"' . l:path . '"' : l:path)
                    \ . ':L' . a:l1 . (a:l2 > a:l1 ? '-L' . a:l2 : '')
    endfunction
    " <leader>yr: the reference to the clipboard (+ and *)
    function! s:YankRef(l1, l2) abort
        if expand('%') ==# ''
            echohl WarningMsg | echo 'Buffer has no file' | echohl None
            return
        endif
        let @+ = s:FileRef(expand('%'), a:l1, a:l2)
        let @* = @+
        echo 'Yanked: ' . @+
    endfunction
    " Paste '@file:L12' / '@file:L12-L30' into the target pane, no Enter
    function! s:TmuxSendRef(l1, l2) abort
        if expand('%') ==# ''
            echohl WarningMsg | echo 'Buffer has no file' | echohl None
            return
        endif
        let l:ref = s:FileRef(expand('%'), a:l1, a:l2) . ' '
        if TmuxSendText(l:ref, 0)
            echo 'Sent ' . l:ref . 'to tmux pane ' . g:vimrc_tmux.target
        endif
    endfunction
    " Paste location-list entries (LSP diagnostics / ALE) as @file:Lnn lines
    function! s:TmuxSendDiagnostics() abort
        let l:items = filter(getloclist(0), 'v:val.valid && v:val.bufnr > 0')
        if empty(l:items)
            echo 'Location list is empty (load diagnostics with <leader>ee first)'
            return
        endif
        let l:lines = []
        for l:item in l:items
            call add(l:lines, s:FileRef(bufname(l:item.bufnr), l:item.lnum, 0)
                        \ . ': '
                        \ . (empty(l:item.type) ? '' : '[' . l:item.type . '] ')
                        \ . substitute(trim(l:item.text), '\n', ' ', 'g'))
        endfor
        if TmuxSendText(join(l:lines, "\n"), 0)
            echo len(l:lines) . ' diagnostics sent to tmux pane '
                        \ . g:vimrc_tmux.target
        endif
    endfunction
    nnoremap <silent> <leader>xx
                \ :<C-u>call TmuxSendText(getline('.'), <SID>EnterCount(getline('.')))<CR>
    xnoremap <silent> <leader>xx
                \ :<C-u>call TmuxSendText(<SID>VisualSelectionText(),
                \ <SID>EnterCount(<SID>VisualSelectionText()))<CR>
    nnoremap <silent> <leader>xc :<C-u>call <SID>TmuxSendCell()<CR>
    nnoremap <silent> <leader>xy :<C-u>call TmuxSendText(getline('.'), 0)<CR>
    xnoremap <silent> <leader>xy
                \ :<C-u>call TmuxSendText(<SID>VisualSelectionText(), 0)<CR>
    " <C-u>: a count (2<leader>xd) must not run the action several times
    nnoremap <leader>xt :<C-u>call <SID>TmuxChooseTarget('target')<CR>
    nnoremap <leader>xT :<C-u>call <SID>TmuxChooseTarget('run_target')<CR>
    nnoremap <silent> <leader>xd :<C-u>call <SID>TmuxSendDiagnostics()<CR>
    nnoremap <silent> <leader>xr :<C-u>call <SID>TmuxSendRef(line('.'), line('.'))<CR>
    xnoremap <silent> <leader>xr :<C-u>call <SID>TmuxSendRef(line("'<"), line("'>"))<CR>
    nnoremap <silent> <leader>px :<C-u>call <SID>TmuxRunFile()<CR>
    nnoremap <silent> <leader>pl :<C-u>call <SID>TmuxRunLast()<CR>

