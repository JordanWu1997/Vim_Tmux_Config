" Python debug (add python breakpoints) --------------------------------------
    " NOTE: <buffer> keeps these keys in python buffers only
    " Python built-in pdb debugger
    autocmd vimrc FileType python
                \ noremap <buffer> <leader>pb Obreakpoint()<Esc>
    "" Python built-in pdb debugger (for python < 3.7)
    "autocmd vimrc FileType python
                "\ noremap <buffer> <leader>pb Oimport pdb; pdb.set_trace()<Esc>
    " <leader>pB: debug the current file in a terminal split; the command is
    " left on the command line to add script arguments, then Enter
    " -- Same virtualenv as tests and <leader>px (TmuxVenvPrefix), from the
    "    project root
    " -- Debugger: ipdb if the venv has it, else pdb; without a venv
    "    g:vimrc_tools.python_debugger (ipdb if installed, else pdb)
    function! s:PythonDebugCmd() abort
        let l:venv = RunVenv()
        if !empty(l:venv)
            let l:dbg = executable(l:venv . '/bin/ipdb') ? 'ipdb' : 'pdb'
        else
            " python3 must be able to import it (an ipdb command on PATH can
            " come from pipx, outside the system python3)
            let l:dbg = g:vimrc_tools.python_debugger
            if l:dbg !=# 'pdb'
                call system('python3 -c ' . shellescape('import ' . l:dbg))
                if v:shell_error
                    let l:dbg = 'pdb'
                endif
            endif
        endif
        " :terminal expands % and #, so escape them in paths
        " Vim runs a :terminal command without a shell unless ++shell (and
        " opens its own window); Neovim runs it through 'shell'
        return escape('terminal ' . (g:vimrc_is_nvim ? '' : '++shell ')
                    \ . 'cd ' . shellescape(ProjectRoot()) . ' && '
                    \ . TmuxVenvPrefix() . 'python3 -m ' . l:dbg . ' '
                    \ . shellescape(expand('%:p')), '%#')
    endfunction
    autocmd vimrc FileType python
                \ noremap <buffer> <leader>pB
                \ :<C-u>update<C-r>=g:vimrc_is_nvim ? ' <bar> split' : ''<CR><CR>:<C-r>=<SID>PythonDebugCmd()<CR><space>

" Python test (vim-test) -----------------------------------------------------
    if s:on('python_tools')
        " NOTE:
        " -- <leader>pt[n/f/l/s/v]: test nearest/file/last/suite, visit last test
        "    file (p for python/pytest; vim-test also supports other languages)
        " -- Inside tmux, the test command runs in the tmux run pane
        "    (g:vimrc_tmux.run_target, else target), like a test terminal next
        "    to vim, but only if that pane runs a shell (never into an agent
        "    prompt; choose the pane with <leader>xT). It runs with the project
        "    virtualenv. Outside tmux: vim/neovim terminal.
        " -- cd to vim's cwd (not the project root): vim-test builds test paths
        "    relative to it
        " -- vim-test is lazy-loaded on the first :Test* command
        function! s:TestTmuxPane(cmd) abort
            call TmuxRunCommand('cd ' . shellescape(getcwd()) . ' && '
                        \ . TmuxVenvPrefix() . a:cmd)
        endfunction
        let g:test#custom_strategies = { 'tmuxpane': function('s:TestTmuxPane') }
        if !empty($TMUX)
            let g:test#strategy = 'tmuxpane'
        elseif g:vimrc_is_nvim
            let g:test#strategy = 'neovim'
        else
            let g:test#strategy = 'vimterminal'
        endif
        let g:test#python#runner = 'pytest'
        nnoremap <leader>ptn :TestNearest<CR>
        nnoremap <leader>ptf :TestFile<CR>
        nnoremap <leader>ptl :TestLast<CR>
        nnoremap <leader>pts :TestSuite<CR>
