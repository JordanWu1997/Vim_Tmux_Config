" GitGutter ------------------------------------------------------------------
    " NOTE:
    " -- Lazy-loaded and disabled at startup (g:gitgutter_enabled = 0)
    " -- Hunk keys (<leader>g[j/k/a/r/P], ]h, [h) load gitgutter and enable it
    "    for the CURRENT buffer only on first use, then do their action
    " -- <leader>gg toggles it for all buffers, <leader>gb for current buffer
    if s:on('coding')
        " Disable all gitgutter key mappings
        let g:gitgutter_map_keys = 0
        " Disable gitgutter at start (enable per buffer on demand)
        let g:gitgutter_enabled = 0
        " Enable gitgutter sign highlight at start
        let g:gitgutter_signs = 1
        " Disable gitgutter line highlight at start
        let g:gitgutter_highlight_lines = 0
        " Disable gitgutter line number highlight at start
        let g:gitgutter_highlight_linenrs = 0
        " Show number of hunk when move between hunks
        let g:gitgutter_show_msg_on_hunk_jumping = 1
        " Show gitgutter prewview in split pane
        let g:gitgutter_preview_win_floating = 0
        " Use Esc key to quit preview pane
        let g:gitgutter_close_preview_on_escape = 1
        " Assign color to GitGutter group
        " -- Re-applied on every ColorScheme event, since :colorscheme clears
        "    highlights (and some themes, e.g. gruvbox, link GitGutter groups)
        function! s:GitGutterHighlight() abort
            highlight GitGutterAdd    cterm=bold ctermfg=10 ctermbg=NONE gui=bold guifg=#009900 guibg=NONE
            highlight GitGutterChange cterm=bold ctermfg=11 ctermbg=NONE gui=bold guifg=#bbbb00 guibg=NONE
            highlight GitGutterDelete cterm=bold ctermfg=9  ctermbg=NONE gui=bold guifg=#ff2222 guibg=NONE
        endfunction
        call s:GitGutterHighlight()
        autocmd vimrc ColorScheme * call s:GitGutterHighlight()
        " Load gitgutter and enable it for current buffer (synchronously, so
        " hunks are ready for the jump/stage action that follows)
        function! s:GitGutterEnsure() abort
            call s:LoadGitPlugin('vim-gitgutter')
            if !gitgutter#utility#getbufvar(bufnr(''), 'enabled', 0)
                let l:async = get(g:, 'gitgutter_async', 1)
                let g:gitgutter_async = 0
                GitGutterBufferEnable
                let g:gitgutter_async = l:async
            endif
        endfunction
        " Run a gitgutter hunk command after s:GitGutterEnsure()
        " -- count is passed to NextHunk/PrevHunk (e.g. 3]h)
        function! s:GitGutterRun(cmd, count) abort
            call s:GitGutterEnsure()
            execute (a:count > 1 ? a:count : '') . a:cmd
        endfunction
        " GitGutter toggle
        nnoremap <leader>gg :GitGutterToggle<CR>
        nnoremap <leader>gb :GitGutterBufferToggle<CR>
        " GitGutter highlight toggle
        nnoremap <leader>ghs :GitGutterSignsToggle<CR>
        nnoremap <leader>ghl :GitGutterLineHighlightsToggle<CR>
        nnoremap <leader>ghn :GitGutterLineNrHighlightsToggle<CR>
        nnoremap <leader>ghe :GitGutterEnable<CR>:GitGutterSignsEnable<CR>
                    \:GitGutterLineHighlightsEnable<CR>
        nnoremap <leader>ghd :GitGutterEnable<CR>:GitGutterDisable<CR>
                    \:GitGutterSignsDisable<CR>:GitGutterLineHighlightsDisable<CR>
        " GitGutter hunk: diff preview
        nnoremap <leader>gq :GitGutterQuickFix<CR>
        nnoremap <silent> <leader>gP
                    \ :<C-u>call <SID>GitGutterRun('GitGutterPreviewHunk', 0)<CR>
        nnoremap <leader>gF :GitGutterFold<CR>
        " GitGutter action: add/restore
        nnoremap <silent> <leader>ga
                    \ :<C-u>call <SID>GitGutterRun('GitGutterStageHunk', 0)<CR>
        nnoremap <silent> <leader>gr
                    \ :<C-u>call <SID>GitGutterRun('GitGutterUndoHunk', 0)<CR>
        " Move through hunks in current buffer
        nnoremap <silent> <leader>gj
                    \ :<C-u>call <SID>GitGutterRun('GitGutterNextHunk', v:count1)<CR>zz
        nnoremap <silent> <leader>gk
                    \ :<C-u>call <SID>GitGutterRun('GitGutterPrevHunk', v:count1)<CR>zz
        " Move through hunks in current buffer (h for hunk)
        nnoremap <silent> ]h
                    \ :<C-u>call <SID>GitGutterRun('GitGutterNextHunk', v:count1)<CR>zz
        nnoremap <silent> [h
                    \ :<C-u>call <SID>GitGutterRun('GitGutterPrevHunk', v:count1)<CR>zz
    endif

