    " Lightline style setup
    function! LightlineStyle(theme, fancy, central_region_opaque)

        " Part 1 - Lightline setup -------------------------------------------
        " Initialize g:lightline variable
        let g:lightline = { 'colorscheme': a:theme }
        " Specify g:lightline dictionary objects
        let g:lightline.enable = { 'statusline': 1, 'tabline': 1 }

        " Part 2 - Statusline setup ------------------------------------------
        " Active statusline
        let g:lightline.active = {
            \ 'left': [ [ 'mode', 'paste' ],
            \           [ 'gitbranch', 'readonly', 'filename', 'modified' ] ],
            \ 'right': [ [ 'percent' ],
            \            [ 'lineinfo' ],
            \            [ 'context', 'spell',
            \              'fileformat', 'fileencoding', 'filetype' ] ] }
        " Inactive statusline
        let g:lightline.inactive = {
            \ 'left': [ [ 'absolutepath', 'modified' ] ],
            \ 'right': [ [ 'percent' ],
            \            [ 'lineinfo' ],
            \            [ 'fileformat', 'fileencoding', 'filetype' ] ] }
        " Statusline component function
        let g:lightline.component_function = {
            \ 'gitbranch': 'LightlineGitbranch',
            \ 'filename': 'LightlineFileName',
            \ 'lineinfo': 'LightlineLineinfo',
            \ 'spell': 'LightlineSpell',
            \ 'fileformat': 'LightlineFileformat',
            \ 'fileencoding': 'LightlineFileencoding',
            \ 'filetype': 'LightlineFiletype',
            \ 'context': 'LightlineContext' }
        " Fancy symbol for statusline separator
        if a:fancy
            let g:lightline.separator = { 'left': "", "right": "" }
            let g:lightline.subseparator = { 'left': '/', 'right': '/' }
        endif

        " Part 3 - Tabline setup (bufferline plugin) -------------------------
        " Tabline
        let g:lightline.tabline = {
            \ 'left': [ ['buffers'] ],
            \ 'right': [ ['tabs'] ] }
        " Tabline component
        let g:lightline.component_type = { 'buffers': 'tabsel' }
        let g:lightline.component_expand = {
            \ 'buffers': 'lightline#bufferline#buffers' }
        " Tabline (bufferline plugin)
        let g:lightline#bufferline#show_number = 4
        let g:lightline#bufferline#shorten_path = 1
        let g:lightline#bufferline#min_buffer_count = 2
        let g:lightline#bufferline#min_tab_count = 2
        let g:lightline#bufferline#unnamed = '[No Name]'
        let g:lightline#bufferline#filter_by_tabpage = 1
        " Fancy character for tabline (bufferline)
        if a:fancy
            let g:lightline#bufferline#enable_devicons = 1
            let g:lightline#bufferline#enable_nerdfont = 1
            let g:lightline#bufferline#unicode_symbols = 1
        endif

        " Part 4 - Miscellaneous setup ---------------------------------------
        " Central bar opaque option
        if !a:central_region_opaque
            let s:palette = g:lightline#colorscheme
                        \#{g:lightline.colorscheme}#palette
            let s:palette.normal.middle = [ [ 'NONE', 'NONE', 'NONE', 'NONE' ] ]
            let s:palette.visual.middle = s:palette.normal.middle
            let s:palette.insert.middle = s:palette.normal.middle
            let s:palette.inactive.middle = s:palette.normal.middle
            let s:palette.tabline.middle = s:palette.normal.middle
            let s:palette.replace.middle = s:palette.normal.middle
        endif

        " Part 5 - Lightline component modules -------------------------------
        " Truncate file path for small window or long filename
        function! LightlineFileName()
            if expand('%:t') ==# ''
                return '[No Name]'
            elseif strlen(expand('%:t')) >= 35
                return expand('%:t')
            elseif winwidth(0) <= 70
                \ || strlen(expand('%:~')) >= 60 || strlen(expand('%:p')) >= 60
                if expand('%:p') =~ '^' . expand('~')
                    return pathshorten(expand('%:~'))
                else
                    return pathshorten(expand('%:p'))
                endif
            else
                " Use ~ as user's home
                if expand('%:p') =~ '^' . expand('~')
                    return expand('%:~')
                else
                    return expand('%:p')
                endif
            endif
        endfunction
        " Hide for small window
        " -- Use fugitive if it is already loaded, otherwise use the cached
        "    branch from LightlineGitbranchCache() (no git plugin needed)
        function! LightlineGitbranch()
            if winwidth(0) <= 80
                return ''
            endif
            if exists('*FugitiveHead')
                return FugitiveHead()
            endif
            return get(b:, 'lightline_git_branch', '')
        endfunction
        " Hide for small window
        function! LightlineSpell()
            return winwidth(0) > 85 ? (&spell ? &spelllang : '') : ''
        endfunction
        " Hide for small window
        " -- Only when unusual (not unix / not utf-8), e.g. a dos file
        function! LightlineFileformat()
            return winwidth(0) > 75 && &fileformat !=# 'unix' ? &fileformat : ''
        endfunction
        " Hide for small window
        function! LightlineFileencoding()
            return winwidth(0) > 60 && &fileencoding !=# ''
                        \ && &fileencoding !=# 'utf-8' ? &fileencoding : ''
        endfunction
        " One context item, the most important for what you are doing:
        " diff mode > search highlight on > git hunks > LSP
        function! LightlineContext()
            for l:Item in [function('LightlineDiffCount'),
                        \ function('LightlineSearchCount'),
                        \ function('LightlineGitHunks'),
                        \ function('LightlineLspStatus')]
                let l:text = l:Item()
                if l:text !=# ''
                    return l:text
                endif
            endfor
            return ''
        endfunction
        " Hide for small window
        function! LightlineFiletype()
            return winwidth(0) > 45 ? (&filetype !=# '' ? &filetype : 'NO FT') : ''
        endfunction
        " Hide for small window
        function! LightlineLineinfo()
            return winwidth(0) > 35 ? printf("%3d:%-2d", line('.'), col('.')) : ''
        endfunction
        " LSP state (only after <leader>Le): 'LSP' = enabled, server names
        " when running for this buffer, e.g. 'LSP:pyright-langserver';
        " 'LSP paused' after <leader>Lp (servers still running)
        " -- Compact in windows 71-90 columns wide: 'LSP:R' running, 'LSP:P' paused
        " -- Hidden in windows of 70 columns or less
        function! LightlineLspStatus()
            let l:width = winwidth(0)
            if l:width <= 70
                return ''
            endif
            if !get(g:, 'lsp_user_enabled', 0)
                " <leader>Lp: servers still run for this filetype
                if !get(g:, 'vimrc_lsp_paused', 0)
                            \ || empty(lsp#get_allowed_servers())
                    return ''
                endif
                return l:width <= 90 ? 'L:P' : 'LSP paused'
            endif
            if l:width <= 90
                return 'L:R'
            endif
            let l:running = []
            for l:name in lsp#get_allowed_servers()
                if lsp#get_server_status(l:name) ==# 'running'
                    call add(l:running, l:name)
                endif
            endfor
            let l:off = exists('*LspFeaturesOff') ? LspFeaturesOff() : []
            return (empty(l:running) ? 'LSP' : 'LSP:' . join(l:running, ','))
                        \ . (empty(l:off) ? '' : ' -' . join(l:off, ' -'))
        endfunction
        " Git hunks 'hunk 3/12': hunks starting at or above the cursor / all
        " hunks (only when gitgutter is already loaded and enabled for this
        " buffer; never loads it). Totals: :GitGutterQuickFix or the signs
        function! LightlineGitHunks()
            if winwidth(0) <= 90 || !exists('*GitGutterGetHunkSummary')
                return ''
            endif
            " hunk = [from_start, from_count, to_start, to_count]
            let l:hunks = gitgutter#hunk#hunks(bufnr(''))
            if empty(l:hunks)
                return ''
            endif
            let l:line = line('.')
            let l:cur = len(filter(copy(l:hunks), 'max([1, v:val[2]]) <= l:line'))
            return printf('hunk %d/%d', l:cur, len(l:hunks))
        endfunction
        " Search matches 'search 3/27' while search highlight is on (after
        " /, ?, *, #, n, N; gone after :noh or <Alt-/>)
        " -- searchcount() (Vim 8.1.1270+ / Neovim 0.5+) stops at 999
        "    matches ('>999') or after 20 ms ('?'), so huge files stay fast
        " -- Cached until the cursor, the text or the pattern changes
        function! LightlineSearchCount()
            if !&hlsearch || !v:hlsearch || empty(@/) || winwidth(0) <= 30
                        \ || !exists('*searchcount')
                return ''
            endif
            let l:key = [bufnr(''), b:changedtick, @/, line('.'), col('.')]
            if get(s:, 'searchcount_key', []) !=# l:key
                let s:searchcount_key = l:key
                let l:sc = {}
                try
                    let l:sc = searchcount({'recompute': 1, 'maxcount': 999,
                                \ 'timeout': 20})
                catch
                endtry
                if empty(l:sc) || l:sc.total == 0
                    let s:searchcount_text = ''
                else
                    let l:max = '>' . l:sc.maxcount
                    let s:searchcount_text = printf('search %s/%s',
                                \ l:sc.current > l:sc.maxcount ? l:max : l:sc.current,
                                \ l:sc.incomplete == 2 ? l:max
                                \ : l:sc.total . (l:sc.incomplete == 1 ? '?' : ''))
                endif
            endif
            return s:searchcount_text
        endfunction
        " Diff hunks 'diff 2/7' in diff mode (vimdiff, git_diff_vim.sh,
        " fugitive :Gdiffsplit): hunks starting at or above the cursor / all
        " hunks, the same hunks ]c and [c jump between
        " -- Hunk starts are found once per change of any diffed buffer
        "    (diff_hlID() per line: ~7-11 ms per 1000 lines) and cached in
        "    b:diffcount_starts; while typing in insert mode the last count
        "    is kept, and it is updated after leaving insert mode
        function! LightlineDiffCount()
            if !&diff || winwidth(0) <= 30
                return ''
            endif
            let l:ticks = map(filter(range(1, winnr('$')),
                        \ 'getwinvar(v:val, "&diff")'),
                        \ 'getbufvar(winbufnr(v:val), "changedtick")')
            let l:key = [winnr('$'), l:ticks]
            if get(b:, 'diffcount_key', []) !=# l:key
                        \ && !(mode() =~# '^[iR]' && exists('b:diffcount_starts'))
                let l:starts = []
                let l:prev = 0
                for l:lnum in range(1, line('$') + 1)
                    let l:in = l:lnum <= line('$') && diff_hlID(l:lnum, 1) != 0
                    " Lines deleted on this side show as filler above l:lnum
                    " (lines added after the last line count from the last line)
                    if (l:in || diff_filler(l:lnum) > 0) && !l:prev
                        call add(l:starts, min([l:lnum, line('$')]))
                    endif
                    let l:prev = l:in
                endfor
                let b:diffcount_starts = l:starts
                let b:diffcount_key = l:key
            endif
            let l:line = line('.')
            return printf('diff %d/%d', len(filter(copy(b:diffcount_starts),
                        \ 'v:val <= l:line')), len(b:diffcount_starts))
        endfunction

    endfunction

