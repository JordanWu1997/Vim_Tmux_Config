" Function - load git plugins on demand --------------------------------------
    " Fugitive and GitGutter are lazy-loaded (see [Git] in plugin list).
    " Keys that use functions/<Plug> maps (not commands) call this first.
    function! s:LoadGitPlugin(name) abort
        let l:guard = { 'vim-fugitive': 'g:loaded_fugitive',
                    \   'vim-gitgutter': 'g:loaded_gitgutter' }
        if !has_key(g:plugs, a:name) || exists(get(l:guard, a:name, ''))
            return
        endif
        call plug#load(a:name)
    endfunction

