# git: version control system
# - Configuration (this file)
#   - $HOME/.gitconfig
#   - <GIT_PROJECT_DIR>/.git/config
# - References:
#   - https://stackoverflow.com/questions/70552371/is-there-a-neovim-version-of-vimdiff
[user]
	email = jordankhwu@gmail.com
	name = jordan
[core]
	editor = nvim
[diff]
    tool = nvimdiff
[difftool]
    prompt = false
[difftool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[merge]
    tool = nvimdiff
    # Conflict markers also show the common ancestor (|||||||), git >= 2.35
    conflictstyle = zdiff3
[rerere]
    # Remember conflict resolutions and reuse them (rebase/merge again)
    enabled = true
[mergetool]
    prompt = true
    keepBackup = false
[mergetool "nvimdiff"]
    # LOCAL | BASE | REMOTE on top, MERGED full width below (cursor there)
    cmd = "nvim -d \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\" -c 'wincmd b' -c 'wincmd J'"
